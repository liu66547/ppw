---
/**
 * 全页电影级太阳系 3D 背景
 *
 * ═══════════════════════════════════════════════════════════════════
 * 这一版是一次彻底重写。和上一版的区别：
 *
 *   上一版：相机绕太阳转，地球在近处，全部在一个小尺度里，
 *          靠"天体在画面边缘"来避让正文 —— 观感是"示意图"。
 *   这一版：按电影分镜重排。相机带着观众从太阳附近一路飞向地球，
 *          最后升到 45~60° 俯瞰整个星系。尺度是真实的量级关系，
 *          所以到了地球那一幕，太阳会变成一颗"小小的亮星"。
 *
 * 分镜（滚动进度 p = 0 ~ 1 驱动全片）：
 *   Act 1  0.00~0.12  只有一颗彗星朝镜头飞来，四周空寂
 *   Act 2  0.12~0.38  镜头后退并右转，太阳从右后方扫向右前方，光芒炸开
 *   Act 3  0.38~0.60  太阳缩成小亮点；月球先在右侧出现，地球随后从左侧入画
 *   Act 4  0.60~0.74  掠过地球时短暂特写中国板块
 *   Act 5  0.74~1.00  继续后退、镜头抬升，收在 45~60° 的太阳系俯瞰
 *
 * 三个关键实现决定：
 *
 *   1. 彗星用【镜头相对定位】而不是世界直线
 *      分镜要求它全程在画面里、并且在指定一侧（Act 2 在左、Act 4 在右）。
 *      如果放在世界坐标系的直线上，相机的旋转会把它甩出画面。
 *      所以每帧把它放在"相机屏幕射线"上：位置由屏幕坐标 x/y 决定。
 *      这是电影里的常规做法（hero 元素跟着机位），尾巴由它的世界位置
 *      历史生成，所以看起来依然是自然拖尾。
 *
 *   2. 视线方向用【屏幕位置反解】而不是手填关键帧
 *      想让太阳落在屏幕 (0.84, 0.30)，就直接反解出那个朝向。
 *      手填关键帧时任一帧的微小误差都会让天体扫过整个画面。
 *
 *   3. 尺度：太阳半径 420，日地距离 20000
 *      从地球看太阳的视角约 2.4°（真实是 0.53°）。
 *      没有照搬真实比例 —— 真实比例下地球会小到看不见，
 *      但 2.4° 已经足够让它"看起来是一颗远处的亮星"而不是一颗球。
 * ═══════════════════════════════════════════════════════════════════
 */

---


<div id="ds-bg" aria-hidden="true"></div>

<style>
  /* 挂载点本身不显示内容，只做存在性标记 */
  #ds-bg {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    visibility: hidden;
  }

  /* ── 3D 画布层 ────────────────────────────────────────────
     必须固定在最底层（z-index: -1），且 z-index 为负时
     只有 canvas 自身不透明才能被看到。
     注意：这个 div 是 JS 创建的，没有 Astro 的作用域 hash 属性，
     所以必须用 :global() 才生效。 */
  :global(.ds-canvas) {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    overflow: hidden;
  }
  :global(.ds-canvas canvas) {
    display: block;
    width: 100% !important;
    height: 100% !important;
  }

  /* 加载中的呼吸指示（3D 就绪后移除） */
  :global(.ds-canvas.is-loading::after) {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 42px;
    height: 42px;
    margin: -21px 0 0 -21px;
    border-radius: 50%;
    border: 1px solid rgba(120, 190, 255, 0.22);
    border-top-color: rgba(150, 220, 255, 0.72);
    animation: ds-spin 1.1s linear infinite;
  }
  @keyframes ds-spin {
    to {
      transform: rotate(360deg);
    }
  }

  /* ── 页面基底（兜底）─────────────────────────────────────
     ⚠️ 这一层是"永不白屏"的保证。
     3D 没启动（WebGL 不可用 / three 加载失败 / 系统开了
     「减少动画效果」）时，页面依然是完整的深空，而不是纯白或纯黑。 */
  :global(body.ds-3d-page) {
    background-color: #04060c;
    background-image:
      radial-gradient(circle at 1px 1px, rgba(120, 160, 220, 0.05) 1px, transparent 0),
      radial-gradient(ellipse 130% 90% at 50% 42%, #070c16 0%, #04060c 55%, #010204 100%);
    background-size: 34px 34px, 100% 100%;
    background-attachment: fixed, fixed;
  }
  :global(body.ds-3d-page > .aurora) {
    opacity: 0 !important;
    transition: opacity 0.6s ease;
  }

  /* ── 阅读罩 ──────────────────────────────────────────────
     压在画布之上、正文之下。它的唯一职责是：当画面里有巨大亮源
     （Act 2 的太阳近景）经过正文后方时，把那一块压暗保证可读性。

     强度由 JS 每帧写入 CSS 变量，随滚动减到 0 ——
     因为页面越往后，亮源离得越远，罩子就只剩"白白压暗文字"的副作用了。
     联系板块在 88% 之后才入画，那里必须已经是 0。 */
  :global(.ds-scrim) {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    opacity: var(--ds-scrim-opacity, 0);
    background:
      radial-gradient(
        ellipse 96% 82% at 50% 52%,
        rgba(3, 6, 12, 0.60) 0%,
        rgba(3, 6, 12, 0.52) 42%,
        rgba(3, 6, 12, 0.26) 68%,
        rgba(3, 6, 12, 0) 88%
      ),
      radial-gradient(
        ellipse 122% 112% at 50% 50%,
        rgba(0, 0, 0, 0) 52%,
        rgba(0, 0, 0, 0.24) 100%
      );
  }

  /* 正文压在画布之上 */
  :global(body.ds-3d-page main) {
    position: relative;
    z-index: 1;
  }
  :global(body.ds-3d-page header#site-nav) {
    z-index: 40;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.ds-canvas.is-loading::after) {
      animation: none;
    }
  }
</style>

<script>
  import type * as THREE from 'three';

  /* 真实行星贴图（Solar System Scope，基于 NASA 数据，CC BY 4.0）。
     ⚠️ 这些 import 必须写在 <script> 里，不能放在 frontmatter ——
     Astro 的 script 是独立模块，看不到 frontmatter 的变量。
     Astro 会把它们处理成带哈希的静态资源，import 得到的是 ImageMetadata，
     所以下面 loadTex() 兼容 { src } 形态。 */
  import earthDayUrl from '../assets/textures/earth_day.jpg';
  import earthCloudsUrl from '../assets/textures/earth_clouds.jpg';
  import earthLightsUrl from '../assets/textures/earth_lights.png';
  import moonMapUrl from '../assets/textures/moon.jpg';

  const host = document.getElementById('ds-bg');

  if (host) {
    /* 无条件接管页面底色：它同时负责"让画布透出来"和"3D 挂了兜底" */
    document.body.classList.add('ds-3d-page');

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let webglOK = false;
    let webglWhy = '';
    try {
      const probe = document.createElement('canvas');
      const gl2 = probe.getContext('webgl2');
      const gl1 = gl2 ? null : probe.getContext('webgl');
      webglOK = !!(window.WebGLRenderingContext && (gl2 || gl1));
      if (!webglOK) webglWhy = 'no-webgl-context';
    } catch {
      webglOK = false;
      webglWhy = 'webgl-probe-threw';
    }

    const reason = !webglOK ? webglWhy : reduceMotion ? 'reduced-motion' : '';
    if (reason) {
      document.body.dataset.dsFallback = reason;
      console.info(
        '[ds-bg] 3D 背景未启动（原因：' + reason + '），' +
          '已使用静态深空背景，页面内容不受影响。',
      );
    } else {
      /* 3D 用到的模块全部走动态导入：首屏主包不含 three，
         正文先渲染，3D 随后到位。后处理模块只在非移动端加载。 */
      const LOW = window.matchMedia('(max-width: 767px)').matches;
      const mods: Promise<unknown>[] = [
        import('three'),
        import('three/examples/jsm/postprocessing/EffectComposer.js'),
        import('three/examples/jsm/postprocessing/RenderPass.js'),
        import('three/examples/jsm/postprocessing/OutputPass.js'),
      ];
      if (!LOW) {
        mods.push(import('three/examples/jsm/postprocessing/UnrealBloomPass.js'));
      }

      Promise.all(mods)
        .then((loaded) => {
          const THREE = loaded[0] as typeof import('three');
          const { EffectComposer } = loaded[1] as typeof import('three/examples/jsm/postprocessing/EffectComposer.js');
          const { RenderPass } = loaded[2] as typeof import('three/examples/jsm/postprocessing/RenderPass.js');
          const { OutputPass } = loaded[3] as typeof import('three/examples/jsm/postprocessing/OutputPass.js');
          const bloomMod = loaded[4] as typeof import('three/examples/jsm/postprocessing/UnrealBloomPass.js') | undefined;

          try {
            boot(THREE, { EffectComposer, RenderPass, OutputPass, UnrealBloomPass: bloomMod?.UnrealBloomPass, LOW });
          } catch (err) {
            document.body.dataset.dsFallback = 'boot-failed';
            console.warn('[ds-bg] 3D 场景初始化失败，已退回静态深空背景', err);
          }
        })
        .catch((err) => {
          document.body.dataset.dsFallback = 'three-load-failed';
          console.warn('[ds-bg] Three.js 加载失败，已退回静态深空背景', err);
        });
    }

    /* ── 滚动进度状态 ────────────────────────────────────────
       这两个变量与 readScroll 必须声明在 boot() 之前：
       boot() 要在挂载阅读罩之前先读一次滚动位置，
       好让它带着正确的初始强度出现（否则第一帧会按 CSS 兜底值变暗，
       再被动画循环改回来 —— 那是一次可见的闪烁）。 */
    let rawProgress = 0;
    let progress = 0;

    function readScroll() {
      const doc = document.documentElement;
      const total = doc.scrollHeight - window.innerHeight;
      rawProgress = total <= 0 ? 0 : Math.min(1, Math.max(0, window.scrollY / total));
    }

    type Mods = {
      EffectComposer: any;
      RenderPass: any;
      OutputPass: any;
      UnrealBloomPass?: any;
      LOW: boolean;
    };

    function boot(THREE: typeof import('three'), mods: Mods): void {
      const LOW = mods.LOW;

      /* ══════════════════════════════════════════════════════
         0. 画布层
         ══════════════════════════════════════════════════════ */
      const canvasHost = document.createElement('div');
      canvasHost.className = 'ds-canvas is-loading';
      document.body.appendChild(canvasHost);

      const scrim = document.createElement('div');
      scrim.className = 'ds-scrim';

      /** 滚动进度 -> 阅读罩强度（Act 1 满强度，Act 5 归零） */
      const scrimOpacityFor = (p: number) => {
        const t = Math.min(1, Math.max(0, p));
        if (t <= 0.34) return 1;
        if (t <= 0.52) return 1 - smooth(0.34, 0.52, t) * 0.55;
        const k = smooth(0.52, 0.74, t);
        return 0.45 * (1 - k);
      };

      readScroll();
      scrim.style.setProperty('--ds-scrim-opacity', scrimOpacityFor(rawProgress).toFixed(3));
      document.body.appendChild(scrim);

      /* ══════════════════════════════════════════════════════
         1. 渲染器 / 相机 / 场景
         ══════════════════════════════════════════════════════ */
      const renderer = new THREE.WebGLRenderer({
        antialias: !LOW,
        alpha: true,
        powerPreference: 'high-performance',
      });
      let pixelRatio = Math.min(window.devicePixelRatio, LOW ? 1.5 : 2);
      renderer.setPixelRatio(pixelRatio);
      renderer.setSize(window.innerWidth, window.innerHeight, false);
      renderer.outputColorSpace = THREE.SRGBColorSpace;
      renderer.toneMapping = THREE.ACESFilmicToneMapping;
      renderer.toneMappingExposure = LOW ? 0.82 : 0.86;
      renderer.domElement.style.pointerEvents = 'none';
      canvasHost.appendChild(renderer.domElement);

      const scene = new THREE.Scene();
      /* 雾只用来柔化极远处星点的硬边，密度必须极低：
         这一版场景尺度到 6 万单位，原来的 2.6e-5 会把地球整颗雾掉。 */
      scene.fog = new THREE.FogExp2(0x04060c, 2.2e-7);

      const camera = new THREE.PerspectiveCamera(
        52,
        window.innerWidth / window.innerHeight,
        4,
        600000,
      );

      /* ══════════════════════════════════════════════════════
         2. 尺度常量
         ══════════════════════════════════════════════════════ */
      const SUN_R = 420;
      const SE_DIST = 20000;                 // 日地距离
      const EARTH_R = 150;
      const EARTH_POS = new THREE.Vector3(SE_DIST, 0, 0);
      const MOON_R = 40;
      const MOON_POS = new THREE.Vector3(SE_DIST + 300, 90, 720);

      /* ══════════════════════════════════════════════════════
         3. 小工具
         ══════════════════════════════════════════════════════ */
      const clamp01 = (v: number) => Math.min(1, Math.max(0, v));
      const lerp = (a: number, b: number, t: number) => a + (b - a) * t;

      /** smoothstep：区间外夹紧，区间内三次缓动 */
      function smooth(a: number, b: number, x: number): number {
        const t = clamp01((x - a) / (b - a));
        return t * t * (3 - 2 * t);
      }

      /** 3D 值噪声（给所有程序化着色器共用） */
      const NOISE_GLSL = /* glsl */ `
        float dsHash(vec3 p) {
          p = fract(p * 0.3183099 + vec3(0.71, 0.113, 0.419));
          p *= 17.0;
          return fract(p.x * p.y * p.z * (p.x + p.y + p.z));
        }
        float dsNoise(vec3 x) {
          vec3 i = floor(x);
          vec3 f = fract(x);
          f = f * f * (3.0 - 2.0 * f);
          return mix(
            mix(mix(dsHash(i + vec3(0, 0, 0)), dsHash(i + vec3(1, 0, 0)), f.x),
                mix(dsHash(i + vec3(0, 1, 0)), dsHash(i + vec3(1, 1, 0)), f.x), f.y),
            mix(mix(dsHash(i + vec3(0, 0, 1)), dsHash(i + vec3(1, 0, 1)), f.x),
                mix(dsHash(i + vec3(0, 1, 1)), dsHash(i + vec3(1, 1, 1)), f.x), f.y),
            f.z);
        }
        float dsFbm(vec3 p, int oct) {
          float v = 0.0, a = 0.5;
          for (int i = 0; i < 8; i++) {
            if (i >= oct) break;
            v += a * dsNoise(p);
            p *= 2.02;
            a *= 0.5;
          }
          return v;
        }
        /** 脊状噪声：给丝状结构（日冕喷流、星云筋络）用 */
        float dsRidge(vec3 p, int oct) {
          float v = 0.0, a = 0.5;
          for (int i = 0; i < 8; i++) {
            if (i >= oct) break;
            float n = 1.0 - abs(dsNoise(p) * 2.0 - 1.0);
            v += a * n * n;
            p *= 2.06;
            a *= 0.5;
          }
          return v;
        }
      `;

      /** 柔和圆形贴图：所有辉光 Sprite 共用 */
      function makeSoftSprite(inner: string, mid: string, size = 256): THREE.Texture {
        const cv = document.createElement('canvas');
        cv.width = cv.height = size;
        const ctx = cv.getContext('2d')!;
        const g = ctx.createRadialGradient(size / 2, size / 2, 0, size / 2, size / 2, size / 2);
        g.addColorStop(0, inner);
        g.addColorStop(0.32, mid);
        g.addColorStop(1, 'rgba(0,0,0,0)');
        ctx.fillStyle = g;
        ctx.fillRect(0, 0, size, size);
        const t = new THREE.CanvasTexture(cv);
        t.colorSpace = THREE.SRGBColorSpace;
        return t;
      }

      /** 十字星芒贴图：给少数亮星做星芒点缀 */
      function makeSparkleTexture(size = 128): THREE.Texture {
        const cv = document.createElement('canvas');
        cv.width = cv.height = size;
        const ctx = cv.getContext('2d')!;
        const c = size / 2;
        const g = ctx.createRadialGradient(c, c, 0, c, c, c * 0.4);
        g.addColorStop(0, 'rgba(255,255,255,1)');
        g.addColorStop(0.5, 'rgba(214,238,255,0.5)');
        g.addColorStop(1, 'rgba(150,200,255,0)');
        ctx.fillStyle = g;
        ctx.fillRect(0, 0, size, size);

        ctx.globalCompositeOperation = 'lighter';
        const ray = (x1: number, y1: number, w: number, a: number) => {
          const lg = ctx.createLinearGradient(c, c, x1, y1);
          lg.addColorStop(0, 'rgba(255,255,255,' + a + ')');
          lg.addColorStop(0.4, 'rgba(200,230,255,' + a * 0.25 + ')');
          lg.addColorStop(1, 'rgba(150,200,255,0)');
          ctx.strokeStyle = lg;
          ctx.lineWidth = w;
          ctx.lineCap = 'round';
          ctx.beginPath();
          ctx.moveTo(c, c);
          ctx.lineTo(x1, y1);
          ctx.stroke();
        };
        ray(size, c, 1.6, 0.95);
        ray(0, c, 1.6, 0.95);
        ray(c, 0, 1.6, 0.95);
        ray(c, size, 1.6, 0.95);
        ray(size * 0.84, size * 0.16, 0.9, 0.4);
        ray(size * 0.16, size * 0.84, 0.9, 0.4);
        ctx.globalCompositeOperation = 'source-over';

        const t = new THREE.CanvasTexture(cv);
        t.colorSpace = THREE.SRGBColorSpace;
        return t;
      }

      /**
       * 拖尾贴图：横向（沿长度）渐隐、纵向（宽度）柔边。
       * 用于彗星的屏幕空间拖尾 —— 左端是彗核（最亮），右端完全透明。
       */
      function makeStreakTexture(w = 256, h = 64): THREE.Texture {
        const cv = document.createElement('canvas');
        cv.width = w;
        cv.height = h;
        const ctx = cv.getContext('2d')!;
        const img = ctx.createImageData(w, h);
        const d = img.data;
        for (let y = 0; y < h; y++) {
          // 纵向：中心亮、两边柔
          const v = (y / (h - 1)) * 2 - 1;
          const vert = Math.pow(Math.max(0, 1 - v * v), 1.6);
          for (let x = 0; x < w; x++) {
            // 横向：从彗核（x=0）向尾梢快速衰减
            const t = x / (w - 1);
            const along = Math.pow(1 - t, 1.9);
            // 尾梢加一点细碎抖动，避免像一根棍子
            const grain = 0.86 + 0.14 * Math.sin(t * 42.0) * Math.sin(t * 11.0);
            const a = Math.pow(along * vert * grain, 0.9);
            const i = (y * w + x) * 4;
            d[i] = 255;
            d[i + 1] = 252;
            d[i + 2] = 245;
            d[i + 3] = Math.round(Math.min(1, a) * 255);
          }
        }
        ctx.putImageData(img, 0, 0);
        const tex = new THREE.CanvasTexture(cv);
        tex.colorSpace = THREE.SRGBColorSpace;
        return tex;
      }

      /**
       * 星云贴图：径向衰减 × 脊状噪声阈值。
       * 用脊状而不是普通 fbm，是为了得到"丝絮/筋络"的质感，
       * 普通 fbm 阈值切出来是棉花团，没有星云的通透感。
       */
      function makeNebulaTexture(size: number, seed: number): THREE.Texture {
        const cv = document.createElement('canvas');
        cv.width = cv.height = size;
        const ctx = cv.getContext('2d')!;
        const img = ctx.createImageData(size, size);
        const d = img.data;
        const n3 = (x: number, y: number, z: number) => {
          const h = (px: number, py: number, pz: number) => {
            let v = Math.sin(px * 12.9898 + py * 78.233 + pz * 37.719 + seed) * 43758.5453;
            return v - Math.floor(v);
          };
          const ix = Math.floor(x), iy = Math.floor(y), iz = Math.floor(z);
          const fx = x - ix, fy = y - iy, fz = z - iz;
          const ux = fx * fx * (3 - 2 * fx), uy = fy * fy * (3 - 2 * fy), uz = fz * fz * (3 - 2 * fz);
          const L = (a: number, b: number, t: number) => a + (b - a) * t;
          return L(
            L(L(h(ix, iy, iz), h(ix + 1, iy, iz), ux), L(h(ix, iy + 1, iz), h(ix + 1, iy + 1, iz), ux), uy),
            L(L(h(ix, iy, iz + 1), h(ix + 1, iy, iz + 1), ux), L(h(ix, iy + 1, iz + 1), h(ix + 1, iy + 1, iz + 1), ux), uy),
            uz,
          );
        };
        for (let y = 0; y < size; y++) {
          for (let x = 0; x < size; x++) {
            const u = (x / size - 0.5) * 2;
            const v = (y / size - 0.5) * 2;
            const r = Math.sqrt(u * u + v * v);
            // 径向衰减：边缘必须完全透明，否则叠加时会出现方块边
            const falloff = Math.pow(Math.max(0, 1 - r), 2.1);
            if (falloff <= 0.001) {
              const i = (y * size + x) * 4;
              d[i] = d[i + 1] = d[i + 2] = d[i + 3] = 0;
              continue;
            }
            let sum = 0, amp = 0.5, norm = 0;
            for (let o = 0; o < 4; o++) {
              const f = 2.6 * Math.pow(2, o);
              const n = 1 - Math.abs(n3(u * f + 3.1, v * f + 7.7, o * 2.3) * 2 - 1);
              sum += amp * n * n;
              norm += amp;
              amp *= 0.52;
            }
            const fil = sum / norm;
            const a = Math.pow(clamp01((fil - 0.42) * 2.2), 1.5) * falloff;
            const i = (y * size + x) * 4;
            d[i] = 255;
            d[i + 1] = 255;
            d[i + 2] = 255;
            d[i + 3] = Math.round(a * 255);
          }
        }
        ctx.putImageData(img, 0, 0);
        const t = new THREE.CanvasTexture(cv);
        t.colorSpace = THREE.SRGBColorSpace;
        return t;
      }

      /* 贴图加载器 */
      function loadTex(source: string | { src: string }, srgb = true): THREE.Texture {
        const url = typeof source === 'string' ? source : source.src;
        const t = new THREE.TextureLoader().load(url);
        if (srgb) t.colorSpace = THREE.SRGBColorSpace;
        t.anisotropy = renderer.capabilities.getMaxAnisotropy();
        t.wrapS = THREE.RepeatWrapping;
        return t;
      }

      /* ══════════════════════════════════════════════════════
         4. 星空 / 尘埃 / 星云
         ══════════════════════════════════════════════════════ */
      const starUniforms = {
        uTime: { value: 0 },
        uPixelRatio: { value: pixelRatio },
      };

      /** 一层星点：位置/大小/相位 + 顶点着色器里算闪烁 */
      function buildStars(
        count: number,
        rMin: number,
        rMax: number,
        sMin: number,
        sMax: number,
        warmRatio = 0.18,
      ): THREE.Points {
        const pos = new Float32Array(count * 3);
        const col = new Float32Array(count * 3);
        const siz = new Float32Array(count);
        const pha = new Float32Array(count);
        const c = new THREE.Color();
        for (let i = 0; i < count; i++) {
          const r = rMin + Math.pow(Math.random(), 0.6) * (rMax - rMin);
          const th = Math.random() * Math.PI * 2;
          const ph = Math.acos(2 * Math.random() - 1);
          pos[i * 3] = r * Math.sin(ph) * Math.cos(th);
          pos[i * 3 + 1] = r * Math.cos(ph) * 0.72;
          pos[i * 3 + 2] = r * Math.sin(ph) * Math.sin(th);
          const warm = Math.random() < warmRatio;
          c.setHSL(
            warm ? 0.07 + Math.random() * 0.06 : 0.53 + Math.random() * 0.12,
            0.28 + Math.random() * 0.3,
            0.62 + Math.random() * 0.36,
          );
          col[i * 3] = c.r;
          col[i * 3 + 1] = c.g;
          col[i * 3 + 2] = c.b;
          siz[i] = sMin + Math.random() * (sMax - sMin);
          pha[i] = Math.random() * Math.PI * 2;
        }
        const g = new THREE.BufferGeometry();
        g.setAttribute('position', new THREE.BufferAttribute(pos, 3));
        g.setAttribute('aColor', new THREE.BufferAttribute(col, 3));
        g.setAttribute('aSize', new THREE.BufferAttribute(siz, 1));
        g.setAttribute('aPhase', new THREE.BufferAttribute(pha, 1));

        const pts = new THREE.Points(
          g,
          new THREE.ShaderMaterial({
            uniforms: starUniforms,
            transparent: true,
            depthWrite: false,
            blending: THREE.AdditiveBlending,
            fog: false,
            vertexShader: /* glsl */ `
              attribute float aSize;
              attribute float aPhase;
              attribute vec3 aColor;
              uniform float uTime;
              uniform float uPixelRatio;
              varying vec3 vColor;
              varying float vFlick;
              void main() {
                vColor = aColor;
                // 闪烁：低频 + 每个点不同相位，避免整片同步呼吸
                vFlick = 0.62 + 0.38 * sin(uTime * 0.7 + aPhase);
                vec4 mv = modelViewMatrix * vec4(position, 1.0);
                gl_Position = projectionMatrix * mv;
                gl_PointSize = aSize * uPixelRatio * (320.0 / max(-mv.z, 1.0));
              }
            `,
            fragmentShader: /* glsl */ `
              varying vec3 vColor;
              varying float vFlick;
              void main() {
                vec2 d = gl_PointCoord - 0.5;
                float r = length(d);
                if (r > 0.5) discard;
                float a = smoothstep(0.5, 0.02, r);
                gl_FragColor = vec4(vColor, a * vFlick);
              }
            `,
          }),
        );
        pts.frustumCulled = false;
        return pts;
      }

      const starsFar = buildStars(LOW ? 2600 : 5200, 40000, 260000, 60, 190);
      const starsNear = buildStars(LOW ? 700 : 1500, 6000, 70000, 120, 380);
      scene.add(starsFar, starsNear);

      /** 星芒亮星：数量刻意很少 —— 星芒是点缀，多了会花 */
      {
        const count = LOW ? 26 : 58;
        const pos = new Float32Array(count * 3);
        const col = new Float32Array(count * 3);
        const c = new THREE.Color();
        for (let i = 0; i < count; i++) {
          const r = 20000 + Math.random() * 150000;
          const th = Math.random() * Math.PI * 2;
          const ph = Math.acos(2 * Math.random() - 1);
          pos[i * 3] = r * Math.sin(ph) * Math.cos(th);
          pos[i * 3 + 1] = r * Math.cos(ph) * 0.7;
          pos[i * 3 + 2] = r * Math.sin(ph) * Math.sin(th);
          const warm = Math.random() < 0.24;
          c.setHSL(warm ? 0.09 : 0.57, 0.3, 0.9);
          col[i * 3] = c.r;
          col[i * 3 + 1] = c.g;
          col[i * 3 + 2] = c.b;
        }
        const g = new THREE.BufferGeometry();
        g.setAttribute('position', new THREE.BufferAttribute(pos, 3));
        g.setAttribute('color', new THREE.BufferAttribute(col, 3));
        const sparkles = new THREE.Points(
          g,
          new THREE.PointsMaterial({
            size: 2600,
            sizeAttenuation: true,
            vertexColors: true,
            map: makeSparkleTexture(128),
            transparent: true,
            opacity: 0.8,
            depthWrite: false,
            blending: THREE.AdditiveBlending,
            fog: false,
          }),
        );
        sparkles.frustumCulled = false;
        scene.add(sparkles);
        var sparkleField = sparkles;
      }

      /** 尘埃：极细小的点，铺满飞行走廊，让"黑"不突兀 */
      const dustCount = LOW ? 1600 : 4200;
      const dustPos = new Float32Array(dustCount * 3);
      for (let i = 0; i < dustCount; i++) {
        // 走廊形状：沿 X 轴拉长（相机的主飞行方向）
        dustPos[i * 3] = (Math.random() - 0.5) * 90000;
        dustPos[i * 3 + 1] = (Math.random() - 0.5) * 26000;
        dustPos[i * 3 + 2] = (Math.random() - 0.5) * 46000;
      }
      const dustGeo = new THREE.BufferGeometry();
      dustGeo.setAttribute('position', new THREE.BufferAttribute(dustPos, 3));
      const dustField = new THREE.Points(
        dustGeo,
        new THREE.PointsMaterial({
          color: 0x9fb6d8,
          size: 46,
          sizeAttenuation: true,
          transparent: true,
          opacity: 0.5,
          depthWrite: false,
          blending: THREE.AdditiveBlending,
          fog: false,
        }),
      );
      scene.add(dustField);

      /* ── 五彩星云 ──────────────────────────────────────────
         冷色星云铺底（深蓝/紫），暖色与高饱和色相叠上去制造"斑斓"。
         不透明度刻意压低：星云是氛围，太浓会盖过星空细节。 */
      const nebulaGroup = new THREE.Group();
      scene.add(nebulaGroup);
      {
        const texA = makeNebulaTexture(256, 1.7);
        const texB = makeNebulaTexture(256, 9.3);
        const defs = [
          // 主结构：沿走廊分布，保证飞行途中一直有背景层次
          { x: 2000, y: 1200, z: -18000, c: 0x2f6fd0, s: 46000, o: 0.2, t: 0 },
          { x: 12000, y: -2600, z: 16000, c: 0x8a4bd4, s: 52000, o: 0.17, t: 1 },
          { x: 26000, y: 4200, z: -22000, c: 0x1f8f86, s: 48000, o: 0.16, t: 1 },
          { x: -16000, y: 5200, z: 12000, c: 0xc23c7a, s: 42000, o: 0.15, t: 0 },
          // 暖色点缀
          { x: 34000, y: -5200, z: 28000, c: 0xd97a2a, s: 38000, o: 0.14, t: 0 },
          { x: 8000, y: 9000, z: -34000, c: 0xe0a63c, s: 34000, o: 0.1, t: 1 },
          { x: -30000, y: -3000, z: -20000, c: 0xbe4a5e, s: 44000, o: 0.12, t: 1 },
          { x: 46000, y: 2000, z: -8000, c: 0x3ab0a8, s: 40000, o: 0.11, t: 0 },
          // 远景大团块
          { x: 0, y: 0, z: -90000, c: 0x24406e, s: 120000, o: 0.1, t: 0 },
          { x: 20000, y: -20000, z: -70000, c: 0x4a2f7a, s: 100000, o: 0.09, t: 1 },
        ];
        const bases: { sp: THREE.Sprite; base: number; phase: number }[] = [];
        defs.forEach((d, i) => {
          const sp = new THREE.Sprite(
            new THREE.SpriteMaterial({
              map: d.t ? texB : texA,
              color: d.c,
              transparent: true,
              depthWrite: false,
              depthTest: false,
              blending: THREE.AdditiveBlending,
              opacity: d.o,
              fog: false,
            }),
          );
          sp.position.set(d.x, d.y, d.z);
          sp.scale.setScalar(d.s);
          sp.renderOrder = -10;
          nebulaGroup.add(sp);
          bases.push({ sp, base: d.o, phase: i * 1.31 });
        });
        var nebulaBases = bases;
      }

      /* ══════════════════════════════════════════════════════
         5. 太阳
         ══════════════════════════════════════════════════════ */
      const sunUniforms = {
        uTime: { value: 0 },
        uIntensity: { value: 1 },
        /* 0 = 远景，1 = 贴到脸上。
           近距离时必须补高频细节，否则 40° 的日面就是一片平滑色块。 */
        uDetail: { value: 0 },
      };

      const sunCore = new THREE.Mesh(
        new THREE.SphereGeometry(SUN_R, 128, 84),
        new THREE.ShaderMaterial({
          uniforms: sunUniforms,
          fog: false,
          vertexShader: /* glsl */ `
            varying vec3 vObjPos;
            varying vec3 vNormalW;
            varying vec3 vViewDirW;
            void main() {
              vObjPos = position;
              vec4 wp = modelMatrix * vec4(position, 1.0);
              vNormalW = normalize(mat3(modelMatrix) * normal);
              vViewDirW = normalize(cameraPosition - wp.xyz);
              gl_Position = projectionMatrix * viewMatrix * wp;
            }
          `,
          fragmentShader: /* glsl */ `
            precision highp float;
            varying vec3 vObjPos;
            varying vec3 vNormalW;
            varying vec3 vViewDirW;
            uniform float uTime;
            uniform float uIntensity;
            uniform float uDetail;

            ${NOISE_GLSL}

            void main() {
              vec3 n = normalize(vObjPos);
              float fres = 1.0 - clamp(dot(normalize(vNormalW), normalize(vViewDirW)), 0.0, 1.0);

              /* ── 米粒组织：三层不同频率的对流元胞 ──
                 最细的一层用脊状噪声的反相画胞界（胞界比胞心暗），
                 这是真实太阳表面最有辨识度的特征。 */
              float g1 = dsFbm(n * 6.0 + vec3(0.0, uTime * 0.020, 0.0), 4);
              float g2 = dsFbm(n * 15.0 - vec3(uTime * 0.016, 0.0, uTime * 0.011), 3);
              float cells = dsRidge(n * 30.0 + vec3(uTime * 0.012, 0.0, 0.0), 2);
              float granule = (g1 * 0.58 + g2 * 0.30) * (1.0 - cells * 0.34);

              /* 大尺度对流：让明暗真的在流动 */
              float flow = dsFbm(n * 2.3 + vec3(uTime * 0.048, uTime * 0.030, 0.0), 3);
              float heat = clamp(granule * 0.72 + flow * 0.48, 0.0, 1.0);

              /* ── 近视细节 ──────────────────────────────────────
                 远景时上面那几层就够了；但相机贴到太阳旁边时，
                 日面会铺满 40° 的视场，n*6 这种低频噪声就退化成
                 一片平滑的黄色。这里补两层高频米粒：
                   中层 n*58   负责"颗粒"的整体密度
                   高层 n*130  负责颗粒内部的细碎结构
                 胞界（dsRidge 的反相）压暗，才有真实太阳表面那种
                 "元胞之间是暗缝"的质感。
                 与地球的做法一致：只在近景开启，远景自动归零。 */
              if (uDetail > 0.01) {
                float midGrain = dsFbm(n * 58.0 + vec3(0.0, uTime * 0.06, uTime * 0.04), 3);
                float fineGrain = dsFbm(n * 130.0 - vec3(uTime * 0.09, 0.0, 0.0), 2);
                float cellWall = dsRidge(n * 96.0 + vec3(uTime * 0.03, 0.0, 0.0), 2);

                // 颗粒亮度：两层叠加后归一化
                float grain = midGrain * 0.62 + fineGrain * 0.38;
                // 胞界压暗：元胞边缘比胞心暗，这是太阳表面最标志性的特征
                grain *= 1.0 - cellWall * 0.42;

                // 用近景细节替换一部分原 heat，保留大尺度明暗分布
                heat = mix(heat, heat * 0.32 + grain * 1.06, uDetail * 0.92);
              }

              /* 色温分层：核心白热 -> 亮黄 -> 金橙 -> 边缘深橙红 */
              vec3 deep   = vec3(0.86, 0.19, 0.014);
              vec3 mid    = vec3(1.00, 0.55, 0.085);
              vec3 bright = vec3(1.00, 0.87, 0.54);
              vec3 hot    = vec3(1.00, 0.99, 0.96);
              vec3 col = mix(deep, mid, smoothstep(0.06, 0.48, heat));
              col = mix(col, bright, smoothstep(0.38, 0.72, heat));
              col = mix(col, hot, smoothstep(0.70, 0.97, heat));

              /* 黑子 + 半影 */
              float spotF = dsFbm(n * 3.4 + vec3(uTime * 0.006, 41.0, 0.0), 3);
              float spot = smoothstep(0.62, 0.79, spotF);
              float pen = smoothstep(0.57, 0.65, spotF) * (1.0 - spot);
              col = mix(col, col * 0.26, spot * 0.88);
              col = mix(col, col * 0.72, pen * 0.5);

              /* 耀斑：黑子附近的亮斑 */
              float flare = dsRidge(n * 9.0 + vec3(0.0, uTime * 0.032, uTime * 0.021), 2);
              col += vec3(1.0, 0.76, 0.34) * smoothstep(0.70, 0.96, flare) * spot * 1.1;

              /* 临边昏暗 */
              col *= mix(1.0, 0.62, pow(fres, 1.22));

              /* 边缘白炽环：这颗恒星最容易被认出来的特征 */
              /* 近景时这圈环会覆盖很大一片面积、把细节冲掉，
                 所以按 uDetail 衰减。 */
              float rimFade = 1.0 - uDetail * 0.55;
              col += vec3(1.0, 0.98, 0.93) * pow(fres, 3.1) * 1.25 * rimFade;
              col += vec3(1.0, 0.60, 0.19) * pow(fres, 1.6) * 0.42 * rimFade;

              // 热辐射：暗部也带一点自发光，避免死黑
              col += vec3(0.16, 0.09, 0.03) * pow(heat, 3.0);

              gl_FragColor = vec4(col * uIntensity, 1.0);
            }
          `,
        }),
      );
      sunCore.renderOrder = 1;
      const sunGroup = new THREE.Group();
      sunGroup.add(sunCore);

      /* 日冕：三层柔光 Sprite。
         球壳方案实测会与本体形成可见的同心边界，所以用 Sprite。 */
      const HALO_LAYERS = [
        { s: SUN_R * 2.5, i: 'rgba(255,226,170,0.22)', m: 'rgba(255,150,48,0.10)' },
        { s: SUN_R * 5.0, i: 'rgba(255,196,112,0.13)', m: 'rgba(255,118,26,0.055)' },
        { s: SUN_R * 9.0, i: 'rgba(255,164,72,0.07)', m: 'rgba(255,96,18,0.025)' },
      ];
      const sunHalos = HALO_LAYERS.map((d, i) => {
        const sp = new THREE.Sprite(
          new THREE.SpriteMaterial({
            map: makeSoftSprite(d.i, d.m, 256),
            transparent: true,
            depthWrite: false,
            depthTest: false,
            blending: THREE.AdditiveBlending,
            fog: false,
          }),
        );
        sp.scale.setScalar(d.s);
        sp.renderOrder = 3 + i;
        sunGroup.add(sp);
        return sp;
      });

      sunGroup.add(new THREE.PointLight(0xffd9a0, 2.4, 0, 0));

      /* 远距离时太阳必须仍然"亮得有存在感"。
         光晕 Sprite 用的是固定世界单位尺寸，相机退到 2 万单位以外时
         它只剩几十像素，太阳就退化成一颗灰点。
         这里单独加一层"星芒光晕"，每帧按相机到太阳的距离等比缩放，
         让它保持大致恒定的【角直径】—— 远处的太阳依然是画面里最亮的东西。 */
      const sunGlare = new THREE.Sprite(
        new THREE.SpriteMaterial({
          map: makeSoftSprite('rgba(255,252,240,0.95)', 'rgba(255,190,110,0.42)', 256),
          transparent: true,
          depthWrite: false,
          depthTest: false,
          blending: THREE.AdditiveBlending,
          fog: false,
        }),
      );
      sunGlare.renderOrder = 8;
      sunGroup.add(sunGlare);

      scene.add(sunGroup);
      scene.add(new THREE.AmbientLight(0x2a3a54, 0.55));

      /* ══════════════════════════════════════════════════════
         6. 地球
         ══════════════════════════════════════════════════════ */
      const earthUniforms = {
        uTime: { value: 0 },
        uSunDir: { value: new THREE.Vector3(-1, 0, 0) },
        uDetail: { value: 0 },            // 0=远景 1=特写，控制程序化细节强度
        uDayMap: { value: loadTex(earthDayUrl) },
        uCloudMap: { value: loadTex(earthCloudsUrl, false) },
        uLightsMap: { value: loadTex(earthLightsUrl) },
      };

      const earthMesh = new THREE.Mesh(
        new THREE.SphereGeometry(EARTH_R, LOW ? 96 : 144, LOW ? 64 : 96),
        new THREE.ShaderMaterial({
          uniforms: earthUniforms,
          fog: false,
          vertexShader: /* glsl */ `
            varying vec2 vUv;
            varying vec3 vNormalW;
            varying vec3 vViewDirW;
            varying vec3 vObjPos;
            void main() {
              vUv = uv;
              vObjPos = position;
              vec4 wp = modelMatrix * vec4(position, 1.0);
              vNormalW = normalize(mat3(modelMatrix) * normal);
              vViewDirW = normalize(cameraPosition - wp.xyz);
              gl_Position = projectionMatrix * viewMatrix * wp;
            }
          `,
          fragmentShader: /* glsl */ `
            precision highp float;
            varying vec2 vUv;
            varying vec3 vNormalW;
            varying vec3 vViewDirW;
            varying vec3 vObjPos;
            uniform float uTime;
            uniform float uDetail;
            uniform vec3 uSunDir;
            uniform sampler2D uDayMap;
            uniform sampler2D uCloudMap;
            uniform sampler2D uLightsMap;

            ${NOISE_GLSL}

            void main() {
              vec3 N = normalize(vNormalW);
              vec3 L = normalize(uSunDir);
              vec3 V = normalize(vViewDirW);
              vec3 n = normalize(vObjPos);
              float ndl = dot(N, L);
              float lit = smoothstep(-0.18, 0.30, ndl);

              /* ── 日面 ── */
              vec3 day = texture2D(uDayMap, vUv).rgb;
              float lum = dot(day, vec3(0.299, 0.587, 0.114));

              /* 程序化细节补偿：贴图只有 2K，特写时会糊。
                 这里在贴图之上叠一层与地形相关的高频噪声 ——
                 它只在近景（uDetail 高）明显，远景自动消失，
                 效果是"地表有颗粒质感"，而不是"放大了一张小图"。 */
              if (uDetail > 0.01) {
                float relief = dsFbm(n * 160.0, 3);
                float grain = dsFbm(n * 420.0, 2);
                float landMask = smoothstep(0.16, 0.42, lum);   // 只给陆地加细节
                day *= 1.0 + (relief - 0.5) * 0.55 * uDetail * landMask;
                day *= 1.0 + (grain - 0.5) * 0.22 * uDetail;
              }

              /* ── 云层：独立贴图，随时间缓慢西移 ── */
              vec2 cuv = vec2(fract(vUv.x + uTime * 0.0011), vUv.y);
              float clouds = texture2D(uCloudMap, cuv).r;
              clouds = smoothstep(0.14, 0.86, clouds);

              vec3 cloudCol = mix(vec3(0.40, 0.45, 0.55), vec3(1.0, 0.99, 0.97), lit);
              vec3 albedo = mix(day, cloudCol, clouds * 0.82);

              vec3 col = albedo * (0.045 + 1.02 * lit);

              /* ── 夜面城市灯光 ── */
              vec3 lights = texture2D(uLightsMap, vUv).rgb;
              col += lights * (1.0 - lit) * 1.7;

              /* ── 海洋镜面高光（海面在日面图上很暗，用亮度反推） ── */
              float ocean = 1.0 - smoothstep(0.05, 0.17, lum);
              vec3 H = normalize(L + V);
              float spec = pow(max(dot(N, H), 0.0), 60.0);
              col += vec3(1.0, 0.97, 0.90) * spec * ocean * 1.0 * lit * (1.0 - clouds * 0.85);

              /* ── 大气边缘光 ── */
              float fres = 1.0 - clamp(dot(N, V), 0.0, 1.0);
              col += vec3(0.24, 0.54, 1.0) * pow(fres, 2.5) * (0.28 + 1.05 * max(ndl, 0.0));

              gl_FragColor = vec4(col, 1.0);
            }
          `,
        }),
      );
      earthMesh.position.copy(EARTH_POS);
      scene.add(earthMesh);

      /* 外层大气壳 */
      const earthAtmo = new THREE.Mesh(
        new THREE.SphereGeometry(EARTH_R * 1.07, 80, 56),
        new THREE.ShaderMaterial({
          uniforms: { uSunDir: earthUniforms.uSunDir },
          transparent: true,
          depthWrite: false,
          blending: THREE.AdditiveBlending,
          side: THREE.BackSide,
          fog: false,
          vertexShader: /* glsl */ `
            varying vec3 vNormalW;
            varying vec3 vViewDirW;
            void main() {
              vec4 wp = modelMatrix * vec4(position, 1.0);
              vNormalW = normalize(mat3(modelMatrix) * normal);
              vViewDirW = normalize(cameraPosition - wp.xyz);
              gl_Position = projectionMatrix * viewMatrix * wp;
            }
          `,
          fragmentShader: /* glsl */ `
            varying vec3 vNormalW;
            varying vec3 vViewDirW;
            uniform vec3 uSunDir;
            void main() {
              float fres = 1.0 - clamp(dot(normalize(vNormalW), normalize(vViewDirW)), 0.0, 1.0);
              float lit = 0.26 + 0.92 * max(dot(normalize(vNormalW), normalize(uSunDir)), 0.0);
              gl_FragColor = vec4(vec3(0.30, 0.58, 1.0), pow(fres, 2.4) * lit * 0.66);
            }
          `,
        }),
      );
      earthAtmo.position.copy(EARTH_POS);
      scene.add(earthAtmo);

      /* 月球
         ⚠️ 用 MeshBasicMaterial 而不是 Standard：月球在地球幕里
         同样处于"太阳在背后"的关系，用受光材质会变成一颗纯黑圆点。
         它是个小天体，扁平光照不影响观感，但"看不见"会破坏画面。 */
      const moonMesh = new THREE.Mesh(
        new THREE.SphereGeometry(MOON_R, 48, 34),
        new THREE.MeshBasicMaterial({
          map: loadTex(moonMapUrl),
          color: 0x8e8a82,
          fog: false,
        }),
      );
      moonMesh.position.copy(MOON_POS);
      scene.add(moonMesh);

      /* ══════════════════════════════════════════════════════
         7. 其余行星 + 轨道线
         位置固定（放弃公转，保证构图可控）。
         轨道尺度按"1 AU = 20000"排布，但外行星做了压缩，
         不然最终的俯瞰镜头要退到几十万单位以外。
         ══════════════════════════════════════════════════════ */
      type PlanetDef = {
        orbit: number;
        radius: number;
        color: number;
        emissive: number;
        ring?: boolean;
        phase: number;
        seg?: [number, number];
      };

      const planetDefs: PlanetDef[] = [
        { orbit: 5200, radius: 26, color: 0x9c9186, emissive: 0x1a1712, phase: 0.9 },
        { orbit: 8200, radius: 46, color: 0xd8b072, emissive: 0x2a2113, phase: 2.4 },
        { orbit: 13000, radius: 34, color: 0xb4553a, emissive: 0x241009, phase: 4.1 },
        { orbit: 26000, radius: 230, color: 0xc9a678, emissive: 0x2a2216, phase: 1.2 },
        { orbit: 34000, radius: 190, color: 0xcbb98c, emissive: 0x2b2618, ring: true, phase: 3.3 },
        { orbit: 44000, radius: 120, color: 0x8fcbd6, emissive: 0x17282c, phase: 5.6 },
        { orbit: 54000, radius: 116, color: 0x4a6fbf, emissive: 0x101a30, phase: 0.4 },
      ];

      const planets: THREE.Mesh[] = [];

      planetDefs.forEach((def) => {
        const mesh = new THREE.Mesh(
          new THREE.SphereGeometry(def.radius, LOW ? 28 : 44, LOW ? 20 : 32),
          new THREE.MeshStandardMaterial({
            color: def.color,
            emissive: def.emissive,
            roughness: 0.9,
            metalness: 0.04,
          }),
        );
        mesh.position.set(
          Math.cos(def.phase) * def.orbit,
          Math.sin(def.phase * 2.1) * def.orbit * 0.018,
          Math.sin(def.phase) * def.orbit,
        );

        if (def.ring) {
          const ring = new THREE.Mesh(
            new THREE.RingGeometry(def.radius * 1.5, def.radius * 2.4, 96),
            new THREE.MeshBasicMaterial({
              color: 0xd8c79b,
              side: THREE.DoubleSide,
              transparent: true,
              opacity: 0.32,
              depthWrite: false,
              fog: false,
            }),
          );
          ring.rotation.x = Math.PI / 2 - 0.34;
          mesh.add(ring);
        }

        scene.add(mesh);
        planets.push(mesh);

        // 轨道线
        const seg = 260;
        const pts: number[] = [];
        for (let i = 0; i <= seg; i++) {
          const a = (i / seg) * Math.PI * 2;
          pts.push(Math.cos(a) * def.orbit, 0, Math.sin(a) * def.orbit);
        }
        const g = new THREE.BufferGeometry();
        g.setAttribute('position', new THREE.Float32BufferAttribute(pts, 3));
        scene.add(
          new THREE.Line(
            g,
            new THREE.LineBasicMaterial({
              color: 0x5c86b0,
              transparent: true,
              opacity: 0.16,
              depthWrite: false,
              fog: false,
            }),
          ),
        );
      });

      /* 地球的轨道线（单独画，因为它有真实距离） */
      {
        const seg = 300;
        const pts: number[] = [];
        for (let i = 0; i <= seg; i++) {
          const a = (i / seg) * Math.PI * 2;
          pts.push(Math.cos(a) * SE_DIST, 0, Math.sin(a) * SE_DIST);
        }
        const g = new THREE.BufferGeometry();
        g.setAttribute('position', new THREE.Float32BufferAttribute(pts, 3));
        scene.add(
          new THREE.Line(
            g,
            new THREE.LineBasicMaterial({
              color: 0x6fa4d8,
              transparent: true,
              opacity: 0.2,
              depthWrite: false,
              fog: false,
            }),
          ),
        );
      }

      /* ══════════════════════════════════════════════════════
         8. 彗星
         位置由镜头决定（见 cometAt），尾巴按"背离太阳"的方向生成 ——
         这是真实彗尾的物理方向，也保证它看起来一直在朝镜头飞。
         ══════════════════════════════════════════════════════ */
      const cometGroup = new THREE.Group();
      scene.add(cometGroup);

      const cometCore = new THREE.Mesh(
        new THREE.SphereGeometry(26, 28, 20),
        new THREE.MeshBasicMaterial({ color: 0xffffff, fog: false }),
      );
      cometGroup.add(cometCore);

      const cometGlow = new THREE.Sprite(
        new THREE.SpriteMaterial({
          map: makeSoftSprite('rgba(255,255,255,1)', 'rgba(150,235,255,0.6)', 128),
          transparent: true,
          depthWrite: false,
          depthTest: false,
          blending: THREE.AdditiveBlending,
          fog: false,
        }),
      );
      cometGlow.scale.setScalar(420);
      cometGroup.add(cometGlow);

      /* 十字星芒：亮点的经典视觉语言。
         加这一层之后，即使彗星在屏幕上移动很慢，
         也一眼能认出"这是一个发光的飞行物"，而不是一个白点。 */
      const cometFlare = new THREE.Sprite(
        new THREE.SpriteMaterial({
          map: makeSparkleTexture(128),
          color: 0xd8ecff,
          transparent: true,
          depthWrite: false,
          depthTest: false,
          blending: THREE.AdditiveBlending,
          opacity: 0.85,
          fog: false,
        }),
      );
      cometGroup.add(cometFlare);

      /* 彗尾：两条 —— 离子尾（偏蓝、细长笔直）+ 尘埃尾（偏黄、宽而弯） */
      const TAIL_SEG = 34;
      type Tail = {
        mesh: THREE.Mesh;
        pos: Float32Array;
        col: Float32Array;
        width: number;
        rgb: [number, number, number];
      };
      function makeTail(geoColor: [number, number, number], width: number): Tail {
        const geo = new THREE.BufferGeometry();
        const pos = new Float32Array((TAIL_SEG + 1) * 2 * 3);
        const col = new Float32Array((TAIL_SEG + 1) * 2 * 3);
        const idx: number[] = [];
        for (let i = 0; i < TAIL_SEG; i++) {
          const a = i * 2;
          idx.push(a, a + 1, a + 2, a + 1, a + 3, a + 2);
        }
        geo.setIndex(idx);
        geo.setAttribute('position', new THREE.BufferAttribute(pos, 3));
        geo.setAttribute('color', new THREE.BufferAttribute(col, 3));
        const mesh = new THREE.Mesh(
          geo,
          new THREE.MeshBasicMaterial({
            vertexColors: true,
            transparent: true,
            depthWrite: false,
            blending: THREE.AdditiveBlending,
            side: THREE.DoubleSide,
            fog: false,
          }),
        );
        mesh.frustumCulled = false;
        cometGroup.add(mesh);
        return { mesh, pos, col, width, rgb: geoColor };
      }
      const tailIon = makeTail([0.62, 0.86, 1.0], 1.0);
      /* 尘埃尾已停用 —— 它渲染出来是一大片灰褐色楔形，
         用户明确要求删掉（截图里"球左边那个东西"就是它）。
         对象仍创建（type 需要），但不加入场景。 */
      const tailDust = makeTail([1.0, 0.86, 0.62], 2.1);
      tailDust.mesh.visible = false;

      /* 离子尾也停用：ribbon 在世界空间里展开，
         相机一转就会和彗核在屏幕上脱开，变成"旁边飘着一条线"。
         改用下面的 Sprite 拖尾。 */
      tailIon.mesh.visible = false;

      /* ── 彗星拖尾：屏幕空间 Sprite ────────────────────────────
         永远正对镜头，可非等比缩放 + 绕视线旋转，
         所以不管机位怎么变，它都稳稳连在彗核后面。 */
      const cometWake = new THREE.Sprite(
        new THREE.SpriteMaterial({
          map: makeStreakTexture(256, 64),
          color: 0xbfe0ff,
          transparent: true,
          depthWrite: false,
          depthTest: false,
          blending: THREE.AdditiveBlending,
          opacity: 0.9,
          fog: false,
        }),
      );
      cometWake.renderOrder = 6;
      scene.add(cometWake);

      /* 运动轨迹：一条从彗核向后延伸的长线，沿【速度反向】。
         它是"疾驰感"的关键 —— 光有尾巴不够，
         观众还需要看到"它从哪来"这条轨迹。 */
      const TRAIL_SEG = 48;
      const trailGeo = new THREE.BufferGeometry();
      const trailPos = new Float32Array((TRAIL_SEG + 1) * 3);
      const trailCol = new Float32Array((TRAIL_SEG + 1) * 3);
      trailGeo.setAttribute('position', new THREE.BufferAttribute(trailPos, 3));
      trailGeo.setAttribute('color', new THREE.BufferAttribute(trailCol, 3));
      const cometTrail = new THREE.Line(
        trailGeo,
        new THREE.LineBasicMaterial({
          vertexColors: true,
          transparent: true,
          depthWrite: false,
          blending: THREE.AdditiveBlending,
          fog: false,
        }),
      );
      cometTrail.frustumCulled = false;
      cometGroup.add(cometTrail);

      /* 速度线：若干沿运动方向的短线段，散布在彗核周围。
         这是最直接的"在飞"的视觉语言（类似动画里的集中线）。 */
      /* 速度线也停用：它在彗核旁边形成一圈细碎划痕，
         和"删掉左侧那个东西"是同一处问题。 */
      const STREAK_COUNT = 0;
      const streakGeo = new THREE.BufferGeometry();
      const streakPos = new Float32Array(STREAK_COUNT * 2 * 3);
      const streakCol = new Float32Array(STREAK_COUNT * 2 * 3);
      streakGeo.setAttribute('position', new THREE.BufferAttribute(streakPos, 3));
      streakGeo.setAttribute('color', new THREE.BufferAttribute(streakCol, 3));
      const cometStreaks = new THREE.LineSegments(
        streakGeo,
        new THREE.LineBasicMaterial({
          vertexColors: true,
          transparent: true,
          depthWrite: false,
          blending: THREE.AdditiveBlending,
          fog: false,
        }),
      );
      cometStreaks.frustumCulled = false;
      cometGroup.add(cometStreaks);

      /* 彗尾火花 */
      const SPARK_COUNT = LOW ? 90 : 200;
      const sparkPos = new Float32Array(SPARK_COUNT * 3);
      const sparkGeo = new THREE.BufferGeometry();
      sparkGeo.setAttribute('position', new THREE.BufferAttribute(sparkPos, 3));
      const cometSparks = new THREE.Points(
        sparkGeo,
        new THREE.PointsMaterial({
          color: 0xbfe4ff,
          size: 34,
          sizeAttenuation: true,
          transparent: true,
          opacity: 0.8,
          depthWrite: false,
          blending: THREE.AdditiveBlending,
          fog: false,
        }),
      );
      cometSparks.frustumCulled = false;
      cometSparks.visible = false;
      cometGroup.add(cometSparks);

      /* ══════════════════════════════════════════════════════
         9. 分镜：相机路径 + 视线
         ══════════════════════════════════════════════════════ */

      /** 分段 smoothstep 插值（严格经过关键点，不会像样条一样过冲） */
      function pathAt(keys: THREE.Vector3[], p: number): THREE.Vector3 {
        const n = keys.length - 1;
        const t = clamp01(p) * n;
        const i = Math.min(Math.floor(t), n - 1);
        const lt = t - i;
        const e = lt * lt * (3 - 2 * lt);
        return keys[i].clone().multiplyScalar(1 - e).addScaledVector(keys[i + 1], e);
      }

      /**
       * 相机路径。坐标以太阳为原点，黄道面 = XZ，地球在 (+20000, 0, 0)。
       *
       * 两条硬几何约束（都是实测踩出来的）：
       *
       *   ① 必须【越过地球】才能让地球和太阳同框。
       *      停在地球内侧（x < 20000）时，地球在 +X、太阳在 -X，
       *      两者在天空里几乎正好相反（实测夹角 107°），怎么瞄都进不了同一画面。
       *      所以第三幕把相机推到 x ≈ 21700 再回望，夹角降到约 36°。
       *
       *   ② 相机必须待在地球-太阳连线的【-Z 侧】。
       *      同样是"地球在左、太阳在右"，+Z 侧会让太阳落到画面左侧
       *      （手性关系，实测 sun x=-0.64），-Z 侧才对（sun x≈+0.63）。
       *      所以路径在 0.5 之后把 z 穿过 0 走到负值。
       *
       * 各幕意图：
       *   0.00 太阳旁，镜头朝 +Z（背对太阳、也避开地球）→ 画面里只有彗星
       *   0.22 一边后退一边右转，太阳扫进右侧
       *   0.48 太阳缩成亮球，继续后退
       *   0.66 已越过地球回望：地球左侧、太阳中右（真实角径约 1°）
       *   0.74 推近做中国特写（此时太阳已出画，符合自然透视）
       *   1.00 抬高到 45~60° 俯瞰全系
       */
      const CAM_KEYS: THREE.Vector3[] = [
        new THREE.Vector3(2400, 700, 3200),      // 0.00 太阳旁，朝 +Z（太阳在背后）
        new THREE.Vector3(2100, 560, 3800),      // 0.10 悬停、开始右转
        new THREE.Vector3(1500, 400, 2600),      // 0.18 转向，太阳进入右侧
        /* 0.26 是全程离太阳最近的一点：距日心 1157 单位。
           太阳半径 420，等于贴着表面掠过，
           角径约 40° —— 这一帧右侧会被日面压满。 */
        new THREE.Vector3(700, 220, 900),
        new THREE.Vector3(1500, 340, -1100),     // 0.34 掠过之后拉开
        new THREE.Vector3(5600, 560, -4600),     // 0.44
        new THREE.Vector3(13000, 640, -6200),    // 0.54 太阳缩成亮点
        new THREE.Vector3(21700, 320, -1400),    // 0.66 地球左 / 太阳右 同框
        new THREE.Vector3(20450, 300, -300),     // 0.74 中国特写（约 30° 俯角）
        new THREE.Vector3(27000, 5200, -9000),   // 0.86 拉远
        new THREE.Vector3(34000, 27000, 30000),  // 1.00 俯瞰
      ];

      /**
       * 时间重映射：两端略缓、中段匀速。
       *
       * ⚠️ 这里必须"轻"，不能重映射。
       * 踩过的坑：第一版用了 eased*0.88 + c*0.12 + 中段加速，
       * 结果 p=0.62 实际走到了路径的 0.82 处 —— 幕次与关键帧彻底错位，
       * 该出现地球的滚动位置已经在拉远了。
       * 现在只保留两端的轻微缓动，让关键帧 i 大致落在 p = i/(n-1)。
       */
      function shotTiming(p: number): number {
        const c = clamp01(p);
        const eased = c * c * (3 - 2 * c);
        return clamp01(eased * 0.35 + c * 0.65);
      }

      const _fwd = new THREE.Vector3();
      const _rgt = new THREE.Vector3();
      const _up = new THREE.Vector3();
      const _aim = new THREE.Vector3();
      const WORLD_UP = new THREE.Vector3(0, 1, 0);

      /** 反解视线：让 target 落在屏幕 (wx, wy)。wx/wy 以左上角为 (0,0) */
      function aimAt(camPos: THREE.Vector3, target: THREE.Vector3, wx: number, wy: number): THREE.Vector3 {
        _fwd.copy(target).sub(camPos).normalize();
        _rgt.crossVectors(_fwd, WORLD_UP);
        if (_rgt.lengthSq() < 1e-8) _rgt.set(1, 0, 0);
        _rgt.normalize();
        _up.crossVectors(_rgt, _fwd).normalize();

        const tanV = Math.tan((camera.fov * Math.PI) / 360);
        const tanH = tanV * camera.aspect;
        const ox = (wx - 0.5) * 2 * tanH;
        const oy = (0.5 - wy) * 2 * tanV;

        _aim.copy(_fwd).addScaledVector(_rgt, -ox).addScaledVector(_up, -oy);
        return camPos.clone().add(_aim.normalize().multiplyScalar(2000));
      }

      /**
       * 每一帧的彗星屏幕位置。
       * Act 1 正中；Act 2 飘到左侧；Act 4 移到右侧（让地球占左侧）。
       */
      function cometScreen(p: number): { x: number; y: number; d: number } {
        /* 首屏（p=0）落在右侧空白区 0.80/0.26 —— 那里没有正文，
           不会挡住标题和段落。之后向左划过再回到右侧，
           运动幅度更大，速度感也更强（用户："动起来就无所谓了"）。 */
        const x = lerp(
          lerp(0.80, 0.24, smooth(0.04, 0.30, p)),
          lerp(0.24, 0.84, smooth(0.40, 0.68, p)),
          smooth(0.34, 0.46, p),
        );
        // 起始 0.26 是高处的空白带；后段压到 0.30，给右侧的太阳让位
        const y = lerp(0.26, 0.34, smooth(0.06, 0.30, p)) * (1 - smooth(0.3, 0.6, p))
          + 0.30 * smooth(0.3, 0.6, p);
        /* 到镜头的距离：全程缓慢逼近，读起来就是"它在朝你飞" */
        // 结尾（俯瞰）时让它退远，成为画面里的一个远点
        const d = lerp(
          lerp(lerp(4200, 1500, smooth(0, 0.5, p)), 2600, smooth(0.5, 0.8, p)),
          7200,
          smooth(0.80, 1.0, p),
        );
        return { x, y, d };
      }

      /** 相机空间 -> 世界坐标：给定屏幕点与距离，求出世界位置 */
      function screenRayPoint(camPos: THREE.Vector3, lookTarget: THREE.Vector3, wx: number, wy: number, dist: number): THREE.Vector3 {
        _fwd.copy(lookTarget).sub(camPos).normalize();
        _rgt.crossVectors(_fwd, WORLD_UP);
        if (_rgt.lengthSq() < 1e-8) _rgt.set(1, 0, 0);
        _rgt.normalize();
        _up.crossVectors(_rgt, _fwd).normalize();

        const tanV = Math.tan((camera.fov * Math.PI) / 360);
        const tanH = tanV * camera.aspect;
        const ox = (wx - 0.5) * 2 * tanH;
        const oy = (0.5 - wy) * 2 * tanV;

        const dir = _fwd.clone().addScaledVector(_rgt, ox).addScaledVector(_up, oy).normalize();
        return camPos.clone().addScaledVector(dir, dist);
      }

      /**
       * 视线：按幕次决定"谁在画面哪个位置"。
       *
       * 每一幕先算出"该幕理想的视线目标点"，再按进度在它们之间插值。
       * 插值的是【目标点】而不是方向 —— 两个相差很大的方向直接插值
       * 会经过零长度向量导致镜头猛甩，插值目标点则始终平滑。
       */
      function lookAtForP(p: number, camPos: THREE.Vector3): THREE.Vector3 {
        // Act 1：朝 +Z 看向空旷深空（背对太阳，也避开地球方向）
        const emptyAim = camPos.clone().add(new THREE.Vector3(300, 900, 20000));
        const a = aimAt(camPos, emptyAim, 0.5, 0.46);

        // Act 2：太阳被"甩"到右侧（从 0.78 推到 0.9，读起来像掠过）
        const sunX = lerp(0.78, 0.9, smooth(0.16, 0.42, p));
        const b = aimAt(camPos, new THREE.Vector3(0, 0, 0), sunX, 0.34);

        /* Act 3：把地球放到左侧 0.28。
           太阳会因为几何关系自动落在右侧约 0.72~0.78
           （实测两者夹角约 36°，横向 fov 约 78°，所以偏移 0.46 屏宽）。 */
        const c = aimAt(camPos, EARTH_POS, 0.28, 0.44);

        // Act 4：中国特写 —— 地球略偏左，右侧留出空间
        const d = aimAt(camPos, EARTH_POS, 0.42, 0.46);

        // Act 5：回到星系中心
        const e = aimAt(camPos, new THREE.Vector3(0, 0, 0), 0.5, 0.5);

        const out = a.clone();
        out.lerp(b, smooth(0.06, 0.26, p));       // 转向太阳
        out.lerp(c, smooth(0.40, 0.60, p));       // 转向地球
        out.lerp(d, smooth(0.62, 0.72, p));       // 推近特写
        out.lerp(e, smooth(0.78, 0.96, p));       // 回到俯瞰
        return out;
      }

      /** 地球自转：特写时把中国转向镜头 */
      const CHINA_U = 0.79;   // 中国大致经度 105°E -> u=(105+180)/360
      /**
       * 算出"让中国正对镜头"所需的 rotation.y。
       *
       * three.js SphereGeometry 在 (u,v) 处的局部方向是
       *   phi = 2πu, theta = πv
       *   x = -cos(phi)·sin(theta), y = cos(theta), z = sin(phi)·sin(theta)
       * 绕 Y 轴旋转 θ 后，XZ 平面内的方位角从 α 变成 α-θ。
       * 所以要让方位角等于镜头方位角 camAngle，需要 θ = α - camAngle。
       *
       * ⚠️ 符号写反过（写成 camAngle - α），结果特写给到的是美洲。
       */
      function chinaYaw(camPos: THREE.Vector3): number {
        const phi = CHINA_U * Math.PI * 2;
        const localX = -Math.cos(phi);
        const localZ = Math.sin(phi);
        const localAngle = Math.atan2(localZ, localX);
        const camAngle = Math.atan2(camPos.z - EARTH_POS.z, camPos.x - EARTH_POS.x);
        return localAngle - camAngle;
      }

      /** 相机朝向：把上面算出的 look 目标转成四元数（带轻微手持感） */

      /* ══════════════════════════════════════════════════════
         10. 每帧更新
         ══════════════════════════════════════════════════════ */
      const _cometWorld = new THREE.Vector3();
      const _cometPrev = new THREE.Vector3();
      const _velWorld = new THREE.Vector3();
      const _velSmooth = new THREE.Vector3(0, 0, 0);
      /** 尾流方向（单位向量），沿彗星世界速度的反向 */
      const wakeDir = new THREE.Vector3(0, 0, 1);
      let wakeInited = false;
      const tailPath: THREE.Vector3[] = [];
      let tailInited = false;

      function updateScene(p: number, elapsed: number): void {
        const tp = shotTiming(p);

        /* ── 相机 ── */
        const camPos = pathAt(CAM_KEYS, tp);
        // 手持微抖：两个不同频率叠加，单一频率会像机器震动
        camPos.x += Math.sin(elapsed * 0.31) * 26 + Math.sin(elapsed * 0.17 + 1.3) * 18;
        camPos.y += Math.cos(elapsed * 0.24 + 0.7) * 20 + Math.sin(elapsed * 0.13) * 12;
        camPos.z += Math.sin(elapsed * 0.19 + 2.1) * 22;
        camera.position.copy(camPos);

        const look = lookAtForP(p, camPos);
        look.x += Math.sin(elapsed * 0.21 + 0.4) * 40;
        look.y += Math.cos(elapsed * 0.27 + 1.8) * 30;
        camera.lookAt(look);
        camera.rotateZ(Math.sin(elapsed * 0.16) * 0.0022);

        /* ── 彗星：屏幕定位 + 摆动 ────────────────────────────
         *
         * 镜头相对定位保证它始终在画面里，但副作用是"屏幕上纹丝不动"，
         * 静止看几秒会以为那是个白点，认不出是流星。
         *
         * 这里叠三组慢速摆动：
         *   · 两组不同频率的水平/垂直正弦（幅度约屏宽 3%）
         *     单一频率会像机械振动，两组不同频率才像悬浮游动
         *   · 距离脉动 ±9%，彗星尺寸与拖尾长度随之呼吸
         * 幅度刻意控制在不跑出空白区的范围，不会压到正文。
         */
        const cs = cometScreen(p);
        const swayX =
          Math.sin(elapsed * 0.62) * 0.030 + Math.sin(elapsed * 1.07 + 1.7) * 0.012;
        const swayY =
          Math.cos(elapsed * 0.48 + 0.6) * 0.028 + Math.sin(elapsed * 0.93 + 2.3) * 0.011;
        const swayD = 1 + Math.sin(elapsed * 0.37) * 0.09;

        const csx = cs.x + swayX;
        const csy = cs.y + swayY;
        const csd = cs.d * swayD;

        _cometWorld.copy(screenRayPoint(camPos, look, csx, csy, csd));
        cometGroup.position.copy(_cometWorld);

        /* ── 尾流方向 = 世界速度的反向 ──────────────────────────
         *
         * 这是"疾驰感"的核心。原来取的是"背离太阳"，
         * 而太阳在镜头背后，尾巴便正好指向镜头、被透视压成一个点 ——
         * 所以彗星一直在画面里、却看不出在飞。
         *
         * 现在用有限差分算出它的真实世界速度，尾巴沿 -v 拖开。
         * 彗星是镜头相对定位的，所以它相对世界一直在快速移动，
         * 尾流会稳定地甩在身后。
         *
         * 再混入 25% 的"背离太阳"，保留一点真实彗尾的物理意味。
         */
        if (!wakeInited) {
          _cometPrev.copy(_cometWorld);
          wakeInited = true;
        }
        _velWorld.copy(_cometWorld).sub(_cometPrev);

        const awaySun = _cometWorld.clone().normalize();
        if (awaySun.lengthSq() < 0.5) awaySun.set(0, 0, 1);

        /* 尾流方向 = 设计方向 ⊕ 真实速度方向。
         *
         * 为什么不能只用速度：彗星是镜头相对定位的，页面不滚动时
         * 它的世界速度≈0，退回"背离太阳"就会正对镜头、被压成一个点。
         * 所以给一个"左下 + 略入屏"的设计方向 —— 在画面上恒定
         * 呈现为一条斜拖出去的亮带；滚动时再按速度占比混入。
         */
        {
          const fwd = look.clone().sub(camPos).normalize();
          const rgt = new THREE.Vector3().crossVectors(fwd, WORLD_UP).normalize();
          const upv = new THREE.Vector3().crossVectors(rgt, fwd).normalize();
          // 设计方向：偏左、偏下、略微朝屏内
          const designedDir = fwd
            .clone()
            .multiplyScalar(0.34)
            .addScaledVector(rgt, -0.76)
            .addScaledVector(upv, -0.55)
            .normalize();

          let speedBlend = 0;
          if (_velWorld.lengthSq() > 1e-6) {
            _velSmooth.lerp(_velWorld.clone().normalize(), 0.22);
            if (_velSmooth.lengthSq() > 1e-6) {
              wakeDir.copy(_velSmooth).normalize().multiplyScalar(-1);
              // 只看"是否在动"，不做突变：最多混入 55%
              speedBlend = 0.55;
            } else {
              wakeDir.copy(designedDir);
            }
          } else {
            wakeDir.copy(designedDir);
          }
          wakeDir.lerp(designedDir, 1 - speedBlend);
          // 混一点点"背离太阳"，保留真实彗尾的物理意味
          wakeDir.lerp(awaySun, 0.12).normalize();
        }
        _cometPrev.copy(_cometWorld);

        // 尾巴长度与宽度都以"到镜头的距离"为基准 ——
        // 早期版本用了固定常数，结果尾巴展开到 1700+ 单位，
        // 在画面上就是一大块灰色楔形，直接盖住正文。
        const tailLen = csd * 0.95;

        if (!tailInited) {
          for (let i = 0; i <= TAIL_SEG; i++) tailPath.push(_cometWorld.clone());
          tailInited = true;
        }
        tailPath.shift();
        tailPath.push(_cometWorld.clone());

        /* 尾流基底坐标系 —— 有意识地用【屏幕空间】而不是世界空间。
         *
         * 世界空间的尾巴一旦朝向镜头就会被透视压成一个点，
         * 那样无论速度多大，画面上都看不出"在飞"。
         * 改成沿屏幕的左下方向拖开之后，它永远呈现为一条斜向长亮带。
         * 尾巴仍挂在世界坐标里的彗星位置上，所以会随镜头一起旋转，
         * 3D 感不受影响。
         */
        const viewFwd = look.clone().sub(camPos).normalize();
        const viewRgt = new THREE.Vector3().crossVectors(viewFwd, WORLD_UP).normalize();
        const viewUp = new THREE.Vector3().crossVectors(viewRgt, viewFwd).normalize();
        // 屏幕上的左下方向，并略微深入画面
        const tailAxis = viewRgt
          .clone()
          .multiplyScalar(-0.80)
          .addScaledVector(viewUp, -0.58)
          .addScaledVector(viewFwd, 0.28)
          .normalize();
        const tailPerp = new THREE.Vector3().crossVectors(tailAxis, viewFwd).normalize();

        const side = tailPerp.clone();
        const up2 = new THREE.Vector3().crossVectors(tailAxis, tailPerp).normalize();

        /* ── 拖尾（Sprite）──────────────────────────────────────
         * 长度/宽度都用"到镜头的距离"换算，保证任何机位下
         * 屏幕上的观感一致（约 29° 长、2° 宽）。
         * 旋转角用 tailAxis 在屏幕平面的分量算出来 ——
         * 注意 viewUp 实际指向屏幕下方（叉积手性），所以 Y 取反。 */
        {
          // 长度带一点呼吸，和距离脉动呼应
          const len = csd * 0.55 * (1 + Math.sin(elapsed * 1.35) * 0.07);
          const wid = csd * 0.038;
          const dx = tailAxis.dot(viewRgt);
          const dyUp = -tailAxis.dot(viewUp);
          /* 用 center 把锚点钉在贴图的【左端】，
             这样 sprite 的位置就是彗核本身，不需要再手动偏移半个长度。
             之前用默认 center(0.5,0.5) + 手动偏移，结果整条拖尾
             偏离彗核整整一个长度。 */
          cometWake.center.set(0, 0.5);
          cometWake.position.copy(_cometWorld);
          cometWake.scale.set(len, wid, 1);
          /* 尾迹方向再叠一个小角度摆动 —— 它甩起来，
             整个画面就有"物体在动"的感觉了。 */
          cometWake.material.rotation =
            Math.atan2(dyUp, dx) + Math.sin(elapsed * 0.83) * 0.11;
          // 贴图从彗核端开始，所以要把中心挪到一半处（上面已做）
        }

        const buildTail = (
          t: Tail,
          wobble: number,
          lenScale: number,
        ) => {
          for (let i = 0; i <= TAIL_SEG; i++) {
            const f = i / TAIL_SEG;             // 0 = 彗核, 1 = 尾梢
            // 尾流呈锥形张开：越远越宽，这是高速物体尾迹的形态
            const spread = (0.0012 + f * 0.010) * t.width * csd;
            const base = _cometWorld
              .clone()
              .addScaledVector(tailAxis, f * tailLen * lenScale)
              .addScaledVector(tailPerp, Math.sin(f * 7.0 + elapsed * 0.8) * spread * wobble);
            const p0 = base.clone().addScaledVector(tailPerp, spread);
            const p1 = base.clone().addScaledVector(tailPerp, -spread);
            t.pos.set([p0.x, p0.y, p0.z], i * 6);
            t.pos.set([p1.x, p1.y, p1.z], i * 6 + 3);
            const a = Math.pow(1 - f, 0.95);
            const [r, g, b] = t.rgb;
            t.col.set([r * a, g * a, b * a], i * 6);
            t.col.set([r * a, g * a, b * a], i * 6 + 3);
          }
          const geo = t.mesh.geometry;
          (geo.getAttribute('position') as THREE.BufferAttribute).needsUpdate = true;
          (geo.getAttribute('color') as THREE.BufferAttribute).needsUpdate = true;
        };
        buildTail(tailIon, 0.22, 1.0);
        buildTail(tailDust, 0.75, 0.62);

        /* 尾带整体亮度靠顶点色控制（近彗核亮、尾梢透明），
           材质本身保持 opacity 1，避免透明叠加时互相压暗。 */

        /* 运动轨迹那条细线已移除 —— 1px 的 Line 在画面上就是一道
           铅笔划痕，完全不读作"彗星轨迹"。轨迹感交给两条渐宽的
           尾带（下面 buildTail）来承担，那才有体积。
           对应的 geometry 仍保留在场景里但不更新，顶点全为 0，
           不可见也不影响性能。 */

        /* ── 速度线：沿运动方向的短线段，散布在彗核周围 ──
           这是最直接的"在飞"的视觉语言（类似动画里的集中线）。 */
        for (let i = 0; i < STREAK_COUNT; i++) {
          const ang = (i / STREAK_COUNT) * Math.PI * 2 + elapsed * 0.3;
          // 挪到离彗核更远的地方：贴近彗核会糊成一团划痕
          const rad = csd * (0.10 + ((i * 37) % 100) / 100 * 0.16);
          const lateral = side.clone().multiplyScalar(Math.cos(ang) * rad)
            .addScaledVector(up2, Math.sin(ang) * rad);
          const len = csd * (0.04 + ((i * 53) % 100) / 100 * 0.09);
          const head = _cometWorld.clone().add(lateral);
          const tailPt = head.clone().addScaledVector(tailAxis, len);
          streakPos[i * 6] = head.x;
          streakPos[i * 6 + 1] = head.y;
          streakPos[i * 6 + 2] = head.z;
          streakPos[i * 6 + 3] = tailPt.x;
          streakPos[i * 6 + 4] = tailPt.y;
          streakPos[i * 6 + 5] = tailPt.z;
          const a = 0.10 + ((i * 29) % 100) / 100 * 0.18;
          streakCol[i * 6] = 0.80 * a;
          streakCol[i * 6 + 1] = 0.92 * a;
          streakCol[i * 6 + 2] = 1.0 * a;
          streakCol[i * 6 + 3] = 0;
          streakCol[i * 6 + 4] = 0;
          streakCol[i * 6 + 5] = 0;
        }
        (streakGeo.getAttribute('position') as THREE.BufferAttribute).needsUpdate = true;
        (streakGeo.getAttribute('color') as THREE.BufferAttribute).needsUpdate = true;

        // 尾流火花：沿轴散布，越远越稀
        {
          for (let i = 0; i < SPARK_COUNT; i++) {
            const f = Math.pow(Math.random(), 1.4);
            const d2 = f * tailLen * 1.5;
            const rad = f * csd * 0.06;
            const ang = Math.random() * Math.PI * 2;
            const px = _cometWorld.x + tailAxis.x * d2 + side.x * Math.cos(ang) * rad + up2.x * Math.sin(ang) * rad;
            const py = _cometWorld.y + tailAxis.y * d2 + side.y * Math.cos(ang) * rad + up2.y * Math.sin(ang) * rad;
            const pz = _cometWorld.z + tailAxis.z * d2 + side.z * Math.cos(ang) * rad + up2.z * Math.sin(ang) * rad;
            sparkPos[i * 3] = px;
            sparkPos[i * 3 + 1] = py;
            sparkPos[i * 3 + 2] = pz;
          }
          (sparkGeo.getAttribute('position') as THREE.BufferAttribute).needsUpdate = true;
        }

        // 彗核脉冲 + 朝向镜头（尺寸按距离缩放，保证"近大远小"）
        const pulse = 1 + Math.sin(elapsed * 4.2) * 0.1;
        cometCore.scale.setScalar(csd * 0.00045 * pulse);
        cometGlow.scale.setScalar(csd * 0.032 * (1 + Math.sin(elapsed * 2.1) * 0.06));
        cometFlare.scale.setScalar(csd * 0.16 * (1 + Math.sin(elapsed * 1.6 + 0.9) * 0.08));
        // 星芒缓慢自转，读起来是"有能量在流动"
        cometFlare.material.rotation = elapsed * 0.12;

        /* ── 地球 / 月球 / 太阳的朝向与亮度 ──
         *
         * ⚠️ 这里对地球的受光方向做了【刻意的电影化处理】。
         *
         * 物理上：第三幕相机越过地球回望，太阳在地球正后方，
         * 所以镜头看到的必然是地球暗面（实测就是一颗只剩城市灯光的黑球）。
         * 那个画面其实很美，但"看不清地球"不满足分镜要求。
         *
         * 所以把受光方向从"真实太阳方向"朝镜头右侧偏 35°：
         *   · 明暗交界线仍然清晰，球体立体感不受影响
         *   · 受光来自画面右侧 —— 而太阳本来就位于画面右侧，观感自洽
         *   · 结果是约 3/4 球面被照亮，海陆云层都看得清
         */
        {
          const camDir = camPos.clone().sub(EARTH_POS).normalize();
          const camRight = new THREE.Vector3().crossVectors(camDir, WORLD_UP).normalize();
          const towardSun = new THREE.Vector3().subVectors(new THREE.Vector3(0, 0, 0), EARTH_POS).normalize();

          // 远景（Act 1~2）沿用真实方向；进入地球幕之后切到电影化方向
          const cinematic = smooth(0.42, 0.60, p);
          const eff = camDir
            .clone()
            .multiplyScalar(0.82)
            .addScaledVector(camRight, 0.57)   // 约 35°
            .normalize();
          earthUniforms.uSunDir.value
            .copy(towardSun)
            .lerp(eff, cinematic)
            .normalize();
        }

        // 特写强度：只在 Act 4 附近打开程序化细节
        const detailOn = smooth(0.60, 0.70, p) * (1 - smooth(0.80, 0.90, p));
        earthUniforms.uDetail.value = detailOn;

        // 自转 + 中国朝向
        const spin = elapsed * 0.05;
        const toChina = smooth(0.56, 0.72, p);
        const yawChina = chinaYaw(camPos);
        earthMesh.rotation.y = spin * (1 - toChina) + (yawChina + spin * 0.15) * toChina;
        earthMesh.rotation.z = 0.12;

        moonMesh.rotation.y = elapsed * 0.06;

        /* 太阳：亮度与细节都随"贴近程度"调整。
         *
         * closeness 用角径衡量：角径 > 0.55 rad（约 31°）时算贴脸。
         * 近距离必须把亮度压下来 —— 整颗日面的亮度都高于泛光阈值时，
         * 泛光会把细节全部抹平，看起来就是"模糊的一坨黄色"。
         * 压到阈值附近之后，米粒组织才留得住。 */
        {
          const sunDist = Math.max(camPos.length(), SUN_R * 1.2);
          const sunAngRad = 2 * Math.atan(SUN_R / sunDist);
          const closeness = smooth(0.10, 0.55, sunAngRad);
          sunUniforms.uDetail.value = closeness;
          sunUniforms.uIntensity.value = (0.94 - p * 0.08) * (1 - closeness * 0.20);
        }
        sunHalos.forEach((sp, i) => {
          const k = 1 + Math.sin(elapsed * (0.42 + i * 0.15) + i * 1.3) * 0.035;
          sp.scale.setScalar(HALO_LAYERS[i].s * k);
        });

        /* 星芒光晕按距离等比缩放，保持角直径约 4°。
           近景（相机在太阳旁边）时它会被限制住，不至于吃掉整个画面。 */
        {
          const d = camPos.length();
          const glare = Math.min(d * 0.075, SUN_R * 7.5);
          sunGlare.scale.setScalar(glare * (1 + Math.sin(elapsed * 1.7) * 0.04));
        }
        sunCore.rotation.y = elapsed * 0.007;

        /* ── 背景缓慢自转，制造视差 ── */
        starsFar.rotation.y = elapsed * 0.0016;
        starsNear.rotation.y = elapsed * 0.0038;
        dustField.rotation.y = elapsed * 0.0022;
        sparkleField.rotation.y = -elapsed * 0.0018;
        nebulaGroup.rotation.y = elapsed * 0.0026;
        nebulaGroup.position.y = Math.sin(elapsed * 0.05) * 260;
        nebulaBases.forEach(({ sp, base, phase }) => {
          sp.material.opacity = base * (0.9 + 0.1 * Math.sin(elapsed * 0.1 + phase));
        });

        /* ── 阅读罩强度 ── */
        scrim.style.setProperty('--ds-scrim-opacity', scrimOpacityFor(p).toFixed(3));
      }

      /* ══════════════════════════════════════════════════════
         11. 后处理（泛光）
         ══════════════════════════════════════════════════════ */
      let composer: any = null;
      if (!LOW && mods.UnrealBloomPass) {
        composer = new mods.EffectComposer(renderer);
        composer.addPass(new mods.RenderPass(scene, camera));
        const bloom = new mods.UnrealBloomPass(
          new THREE.Vector2(window.innerWidth * 0.5, window.innerHeight * 0.5),
          0.42,   // strength
          0.62,   // radius
          0.82,   // threshold
        );
        composer.addPass(bloom);
        composer.addPass(new mods.OutputPass());
        composer.setSize(window.innerWidth, window.innerHeight);
      }

      /* ══════════════════════════════════════════════════════
         12. 自适应尺寸 / 滚动 / 生命周期
         ══════════════════════════════════════════════════════ */
      function onResize(): void {
        const w = window.innerWidth;
        const h = window.innerHeight;
        camera.aspect = w / h;
        camera.updateProjectionMatrix();
        renderer.setSize(w, h, false);
        if (composer) composer.setSize(w, h);
        starUniforms.uPixelRatio.value = Math.min(window.devicePixelRatio, LOW ? 1.5 : 2);
        readScroll();
      }
      window.addEventListener('resize', onResize, { passive: true });
      window.addEventListener('scroll', readScroll, { passive: true });
      onResize();

      let running = true;
      let lastStamp = performance.now();
      let elapsedTime = 0;

      /* ── 自适应降质 ──────────────────────────────────────────
         这一版比上一版重（泛光后处理 + 更多星云），弱显卡可能吃力。
         在前 120 帧里统计真实帧率，按档位依次降：
           ① 帧率 < 45  -> 像素比降到 1（画质影响最小、收益最大）
           ② 帧率 < 30  -> 关掉泛光后处理（保流畅，辉光仍有 Sprite 兜底）
         只降不升，避免在阈值附近来回抖动。 */
      let qualityTier = 0;
      let frameSamples = 0;
      let frameAccum = 0;

      function adaptQuality(dtMs: number): void {
        if (qualityTier >= 2) return;
        frameSamples++;
        frameAccum += dtMs;
        if (frameSamples < 120) return;
        const fps = 1000 / (frameAccum / frameSamples);
        frameSamples = 0;
        frameAccum = 0;
        if (qualityTier === 0 && fps < 45 && pixelRatio > 1) {
          qualityTier = 1;
          pixelRatio = 1;
          renderer.setPixelRatio(1);
          starUniforms.uPixelRatio.value = 1;
          onResize();
          console.info('[ds-bg] 帧率偏低（' + fps.toFixed(0) + ' fps），已降低渲染分辨率');
        } else if (qualityTier <= 1 && fps < 30 && composer) {
          qualityTier = 2;
          composer = null;
          console.info('[ds-bg] 帧率仍偏低（' + fps.toFixed(0) + ' fps），已关闭泛光后处理');
        }
      }

      function frame(): void {
        if (!running) return;
        requestAnimationFrame(frame);

        const now = performance.now();
        const dt = now - lastStamp;
        elapsedTime += Math.min(0.05, dt / 1000);
        lastStamp = now;
        adaptQuality(dt);

        const diff = rawProgress - progress;
        progress += diff * 0.06;
        if (Math.abs(diff) < 0.0002) progress = rawProgress;

        starUniforms.uTime.value = elapsedTime;
        sunUniforms.uTime.value = elapsedTime;
        earthUniforms.uTime.value = elapsedTime;

        updateScene(progress, elapsedTime);

        if (composer) composer.render();
        else renderer.render(scene, camera);
      }

      /* 首帧前把 is-loading 去掉（否则会一直转圈） */
      canvasHost.classList.remove('is-loading');
      readScroll();
      progress = rawProgress;
      frame();

      document.addEventListener('visibilitychange', () => {
        if (document.hidden) {
          running = false;
        } else if (!running) {
          running = true;
          lastStamp = performance.now();
          frame();
        }
      });

      renderer.domElement.addEventListener('webglcontextlost', (e: Event) => {
        e.preventDefault();
        running = false;
        canvasHost.remove();
        scrim.remove();
        document.body.dataset.dsFallback = 'context-lost';
        console.warn('[ds-bg] WebGL 上下文丢失，已退回静态深空背景');
      });

      /* ── 本地校准探针（仅 localhost）────────══════════════
         用来在浏览器里量天体落在屏幕的哪个位置，
         避免"改完不知道画面变成什么样"。 */
      if (/^(localhost|127\.0\.0\.1|\[::1\])$/.test(location.hostname)) {
        (window as unknown as Record<string, unknown>).__dsProbe = (p: number) => {
          const tp = shotTiming(p);
          const savedPos = camera.position.clone();
          const savedQuat = camera.quaternion.clone();

          camera.position.copy(pathAt(CAM_KEYS, tp));
          camera.lookAt(lookAtForP(p, camera.position));
          camera.updateMatrixWorld(true);

          const project = (world: THREE.Vector3) => {
            /* 必须先判断是不是在相机背后 ——
               project() 对背后的点会算出翻转的坐标，看起来像"在画面里"，
               这个假数据会把构图调歪（踩过）。 */
            const dir = world.clone().sub(camera.position);
            const fwd = new THREE.Vector3(0, 0, -1).applyQuaternion(camera.quaternion);
            const behind = dir.dot(fwd) <= 0;
            const v = world.clone().project(camera);
            return {
              x: +((v.x + 1) / 2).toFixed(3),
              y: +((1 - v.y) / 2).toFixed(3),
              behind,
            };
          };

          const cometS = cometScreen(p);
          const out = {
            p,
            sun: project(new THREE.Vector3(0, 0, 0)),
            earth: project(EARTH_POS.clone()),
            moon: project(MOON_POS.clone()),
            comet: { x: cometS.x, y: cometS.y, d: cometS.d },
            sunAngularDeg: +(
              (2 * Math.atan(SUN_R / camera.position.length()) * 180) / Math.PI
            ).toFixed(2),
          };

          camera.position.copy(savedPos);
          camera.quaternion.copy(savedQuat);
          camera.updateMatrixWorld(true);
          return out;
        };
      }
    }
  }
</script>
