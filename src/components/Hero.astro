---
/**
 * 首屏 Hero —— 个人资料页的门面
 *
 * 排版层级（从大到小、从亮到暗）：
 *   姓名（渐变大字） → 身份（标题级） → 信息行（等宽小字） →
 *   一句话主张 → 自我介绍 → 联系方式
 *
 * 视觉细节：
 *   - 姓名用渐变文字，字号与字重拉到最大，是整页唯一的"主角"
 *   - 姓名与身份之间用一条极细的渐变线分隔，制造停顿感
 *   - 信息行用等宽字体 + 分隔点，像数据标签而不是句子
 *   - 入场动画用纯 CSS（.hero-in），不依赖 JS，保证首屏一定可见
 */
import { profile } from '../data/profile';

const contacts = [
  {
    kind: 'github',
    label: 'GitHub',
    value: profile.contact.githubHandle,
    href: profile.contact.github,
    external: true,
  },
  {
    kind: 'gitee',
    label: 'Gitee',
    value: profile.contact.giteeHandle,
    href: profile.contact.gitee,
    external: true,
  },
  {
    kind: 'email',
    label: '邮箱',
    value: profile.contact.email,
    href: `mailto:${profile.contact.email}`,
    external: false,
  },
];
---

<section class="relative overflow-hidden">
  <!-- 背景：点阵纹理，向四周淡出 -->
  <div class="pointer-events-none absolute inset-0 bg-dots mask-fade" aria-hidden="true"></div>

  <div class="wrap relative py-20 md:py-28">
    <div class="max-w-3xl">
      <h1 class="hero-in text-[2.75rem] font-bold leading-[1.05] tracking-[-0.03em] sm:text-6xl md:text-[4.25rem]">
        <span class="text-gradient">{profile.name}</span>
      </h1>

      <!-- 渐变分隔线：在姓名与身份之间制造一个停顿 -->
      <div
        class="hero-in mt-5 flex items-center gap-4"
        style="animation-delay: 0.16s"
        aria-hidden="true"
      >
        <span
          class="h-px w-14 bg-gradient-to-r from-accent-400/80 to-transparent"
        ></span>
      </div>

      <p
        class="hero-in mt-4 text-xl font-semibold tracking-tight text-fog-200 sm:text-2xl md:text-3xl"
        style="animation-delay: 0.2s"
      >
        {profile.title}
      </p>

      <!-- 身份信息行：用等宽字体 + 分隔点，像数据标签而不是句子 -->
      <div
        class="hero-in mt-5 flex flex-wrap items-center gap-x-3 gap-y-2 text-[13px]"
        style="animation-delay: 0.26s"
      >
        <span class="mono inline-flex items-center gap-1.5 text-fog-400">
          <svg class="size-3.5 text-accent-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M22 10v6M2 10l10-5 10 5-10 5z" />
            <path d="M6 12v5c3 3 9 3 12 0v-5" />
          </svg>
          {profile.education.school} · {profile.education.degree}
        </span>
        <span class="text-ink-600" aria-hidden="true">/</span>
        <span class="mono text-fog-400">{profile.education.range}</span>
        <span class="text-ink-600" aria-hidden="true">/</span>
        <span class="mono text-fog-500">{profile.education.note}</span>
      </div>

      <p
        class="hero-in mt-8 max-w-2xl text-base leading-relaxed text-fog-100 sm:text-[1.0625rem]"
        style="animation-delay: 0.32s"
      >
        {profile.tagline}
      </p>

      <p
        class="hero-in mt-3.5 max-w-2xl text-sm leading-[1.9] text-fog-400"
        style="animation-delay: 0.38s"
      >
        {profile.intro}
      </p>
    </div>

    <!-- 联系方式：明确标注每个是什么，不再是几个认不出的图标 -->
    <div class="hero-in mt-11" style="animation-delay: 0.46s">
      <p class="mono text-[11px] uppercase tracking-[0.16em] text-fog-500">联系方式</p>

      <ul class="mt-3.5 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {
          contacts.map((c) => (
            <li>
              <a
                href={c.href}
                target={c.external ? '_blank' : undefined}
                rel={c.external ? 'noopener noreferrer' : undefined}
                class="card card-hoverable group flex items-center gap-3.5 p-4"
              >
                <span
                  class:list={[
                    'grid size-10 shrink-0 place-items-center rounded-lg border transition-colors',
                    c.kind === 'email'
                      ? 'border-accent-500/35 bg-accent-500/10 text-accent-300'
                      : 'border-ink-600 bg-ink-850 text-fog-300 group-hover:border-accent-500/60 group-hover:text-accent-300',
                  ]}
                  aria-hidden="true"
                >
                  {c.kind === 'github' && (
                    <svg class="size-5" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 0-.8.4-1.3.7-1.6-2.7-.3-5.5-1.3-5.5-6 0-1.2.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0c2.3-1.5 3.3-1.2 3.3-1.2.6 1.7.2 2.9.1 3.2.8.8 1.2 1.9 1.2 3.1 0 4.7-2.8 5.7-5.5 6 .4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .3Z" />
                    </svg>
                  )}
                  {c.kind === 'gitee' && (
                    <span class="font-mono text-[15px] font-bold">G</span>
                  )}
                  {c.kind === 'email' && (
                    <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <rect x="2" y="4" width="20" height="16" rx="2" />
                      <path d="m22 7-10 6L2 7" />
                    </svg>
                  )}
                </span>

                <span class="min-w-0 flex-1">
                  <span class="block text-xs text-fog-500">{c.label}</span>
                  <span class="mono mt-0.5 block truncate text-sm text-fog-100 transition-colors group-hover:text-accent-300">
                    {c.value}
                  </span>
                </span>

                <svg
                  class="size-4 shrink-0 text-ink-600 transition-all group-hover:translate-x-0.5 group-hover:text-accent-400"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  {c.external ? (
                    <>
                      <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
                      <polyline points="15 3 21 3 21 9" />
                      <line x1="10" y1="14" x2="21" y2="3" />
                    </>
                  ) : (
                    <>
                      <line x1="5" y1="12" x2="19" y2="12" />
                      <polyline points="12 5 19 12 12 19" />
                    </>
                  )}
                </svg>
              </a>
            </li>
          ))
        }
      </ul>

      <div class="mt-6 flex flex-wrap items-center gap-3">
        <a href="#projects" class="btn btn-primary">
          查看项目
          <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="5" y1="12" x2="19" y2="12" />
            <polyline points="12 5 19 12 12 19" />
          </svg>
        </a>
        <a href={profile.contact.resumeFile} download class="btn btn-ghost">
          <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
            <polyline points="7 10 12 15 17 10" />
            <line x1="12" y1="15" x2="12" y2="3" />
          </svg>
          下载简历 PDF
        </a>
      </div>
    </div>
  </div>
</section>
