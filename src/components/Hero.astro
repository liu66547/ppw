---
/**
 * 首屏 Hero —— 面试官最先看到的 3 秒，决定他是否继续往下看
 * 入场动画用纯 CSS（.hero-in），不依赖 JS，保证首屏一定可见。
 */
import { profile } from '../data/profile';
---

<section class="relative overflow-hidden">
  <!-- 背景：网格 + 向四周淡出 -->
  <div class="pointer-events-none absolute inset-0 bg-grid mask-fade" aria-hidden="true"></div>
  <div
    class="pointer-events-none absolute -top-40 left-1/2 h-96 w-[46rem] -translate-x-1/2 rounded-full bg-accent-500/10 blur-[110px]"
    aria-hidden="true"
  >
  </div>

  <div class="wrap relative py-20 md:py-28">
    <div class="max-w-3xl">
      {
        profile.status.open && (
          <p class="status-dot hero-in">
            {profile.status.label}
          </p>
        )
      }

      <h1 class="hero-in mt-6 text-4xl font-bold leading-[1.1] tracking-tight sm:text-5xl md:text-6xl">
        <span class="text-gradient">{profile.name}</span>
        <span class="mt-2 block text-2xl font-semibold text-fog-400 sm:text-3xl md:text-4xl">
          {profile.title}
        </span>
      </h1>

      <p class="hero-in mono mt-4 text-sm text-fog-500">
        {profile.titleNote} · {profile.location} · {profile.education.year} · {profile.education.note}
      </p>

      <p class="hero-in mt-7 max-w-2xl text-base leading-relaxed text-fog-200 sm:text-lg">
        {profile.tagline}
      </p>

      <p class="hero-in mt-4 max-w-2xl text-sm leading-relaxed text-fog-400">
        {profile.intro}
      </p>

      <!-- 行动按钮：简历下载放第一，招聘方最想要这个 -->
      <div class="hero-in mt-9 flex flex-wrap items-center gap-3">
        <a href={profile.contact.resumeFile} download class="btn btn-primary">
          <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
            <polyline points="7 10 12 15 17 10" />
            <line x1="12" y1="15" x2="12" y2="3" />
          </svg>
          下载简历 PDF
        </a>
        <a href="#projects" class="btn btn-ghost">
          看看我的项目
          <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="5" y1="12" x2="19" y2="12" />
            <polyline points="12 5 19 12 12 19" />
          </svg>
        </a>

        <div class="ml-1 flex items-center gap-1">
          <a
            href={profile.contact.github}
            target="_blank"
            rel="noopener noreferrer"
            class="grid size-10 place-items-center rounded-lg border border-ink-700 bg-ink-850 text-fog-400 transition-colors hover:border-accent-500 hover:text-accent-300"
            aria-label="GitHub 主页"
          >
            <svg class="size-[18px]" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 0-.8.4-1.3.7-1.6-2.7-.3-5.5-1.3-5.5-6 0-1.2.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0c2.3-1.5 3.3-1.2 3.3-1.2.6 1.7.2 2.9.1 3.2.8.8 1.2 1.9 1.2 3.1 0 4.7-2.8 5.7-5.5 6 .4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .3Z" />
            </svg>
          </a>
          <a
            href={profile.contact.gitee}
            target="_blank"
            rel="noopener noreferrer"
            class="grid size-10 place-items-center rounded-lg border border-ink-700 bg-ink-850 font-mono text-[13px] font-bold text-fog-400 transition-colors hover:border-accent-500 hover:text-accent-300"
            aria-label="Gitee 主页"
          >
            G
          </a>
          <a
            href={`mailto:${profile.contact.email}`}
            class="grid size-10 place-items-center rounded-lg border border-ink-700 bg-ink-850 text-fog-400 transition-colors hover:border-accent-500 hover:text-accent-300"
            aria-label="发送邮件"
          >
            <svg class="size-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="2" y="4" width="20" height="16" rx="2" />
              <path d="m22 7-10 6L2 7" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
