---
/**
 * 页脚：醒目的联系方式 + 所在地
 */
import { profile } from '../data/profile';

const year = new Date().getFullYear();

const links = [
  {
    kind: 'github',
    label: 'GitHub',
    value: `@${profile.contact.githubHandle}`,
    href: profile.contact.github,
    external: true,
  },
  {
    kind: 'gitee',
    label: 'Gitee',
    value: `@${profile.contact.giteeHandle}`,
    href: profile.contact.gitee,
    external: true,
  },
  {
    kind: 'email',
    label: '邮箱',
    value: profile.contact.email,
    href: `mailto:${profile.contact.email}`,
    external: false,
  },
];
---

<!--
  注意：这里刻意【不加】深色底（原来是 bg-ink-900/40）。
  加了之后联系板块的文字实渲染亮度比其他板块低约 8%
  （实测文字均值 111.5 vs 其他板块平均 121.6），整块看起来发闷。
  去掉底色后，3D 星野直接透过来，文字亮度与其他板块一致；
  实测星野在这个位置的亮度不会干扰阅读，所以不需要那层遮罩。
  上边框保留，作为板块之间的分隔。
-->
<footer id="contact" class="ds-contact relative border-t border-ink-800">
  <!-- 底部一层微弱光晕，收尾不显得突兀 -->
  <div
    class="pointer-events-none absolute inset-x-0 bottom-0 h-40 bg-gradient-to-t from-accent-500/[0.05] to-transparent"
    aria-hidden="true"
  >
  </div>

  <div class="wrap relative py-16">
    <div class="grid gap-12 lg:grid-cols-[1.15fr_1fr]">
      <!-- 左：主行动号召（放大的欢迎语） -->
      <div>
        <p class="eyebrow">Contact</p>

        <h2 class="mt-4 text-3xl font-bold leading-tight tracking-tight text-white md:text-4xl">
          对我的项目有疑问，<br class="hidden sm:block" />
          或者想看看具体代码？
          <span class="mt-2 block text-accent-300">欢迎直接联系。</span>
        </h2>

        <p class="mt-5 max-w-lg text-sm leading-relaxed text-fog-200">
          接口自动化的分层设计、测试数据怎么做到零残留、缺陷是怎么定位到代码行的 ——
          这些问题我都很乐意展开聊，也欢迎直接翻我的仓库。
        </p>

        <!-- 所在地：按要求放在页面最下方区域 -->
        <div class="mt-6 flex flex-wrap items-center gap-x-3 gap-y-2">
          <p class="inline-flex items-center gap-2 rounded-lg border border-ink-700 bg-ink-850 px-3.5 py-2 text-sm text-fog-200">
            <svg class="size-4 text-accent-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0" />
              <circle cx="12" cy="10" r="3" />
            </svg>
            现居 <span class="font-medium text-fog-50">{profile.location.full}</span>
          </p>
          <p class="inline-flex items-center gap-2 rounded-lg border border-ink-700 bg-ink-850 px-3.5 py-2 text-sm text-fog-200">
            <svg class="size-4 text-accent-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M22 10v6M2 10l10-5 10 5-10 5z" />
              <path d="M6 12v5c3 3 9 3 12 0v-5" />
            </svg>
            {profile.education.school}
            <span class="text-fog-400">
              {profile.education.major} · {profile.education.degree}
            </span>
          </p>
        </div>

        <div class="mt-7 flex flex-wrap gap-3">
          <a href={`mailto:${profile.contact.email}`} class="btn btn-primary">
            <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="2" y="4" width="20" height="16" rx="2" />
              <path d="m22 7-10 6L2 7" />
            </svg>
            发邮件给我
          </a>
          <button type="button" data-resume-preview class="btn btn-ghost">
            <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z" />
              <circle cx="12" cy="12" r="3" />
            </svg>
            在线预览简历
          </button>
          <a href={profile.contact.resumeFile} download class="btn btn-ghost">
            <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
              <polyline points="7 10 12 15 17 10" />
              <line x1="12" y1="15" x2="12" y2="3" />
            </svg>
            下载简历 PDF
          </a>
        </div>
      </div>

      <!-- 右：联系方式清单，每项都标注是什么 -->
      <div class="lg:justify-self-end lg:pt-2">
        <p class="mono text-[11px] uppercase tracking-widest text-fog-300">在哪里找到我</p>

        <ul class="mt-4 space-y-2.5">
          {
            links.map((l) => (
              <li>
                <a
                  href={l.href}
                  target={l.external ? '_blank' : undefined}
                  rel={l.external ? 'noopener noreferrer' : undefined}
                  class="card ds-contact-card group flex w-full items-center gap-3 p-3.5 lg:w-72"
                >
                  <span
                    class="ds-contact-icon grid size-9 shrink-0 place-items-center rounded-lg border border-ink-600 bg-ink-850 transition-colors group-hover:border-accent-500/60 group-hover:text-accent-300"
                    aria-hidden="true"
                  >
                    {l.kind === 'github' && (
                      <svg class="size-4" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 0-.8.4-1.3.7-1.6-2.7-.3-5.5-1.3-5.5-6 0-1.2.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0c2.3-1.5 3.3-1.2 3.3-1.2.6 1.7.2 2.9.1 3.2.8.8 1.2 1.9 1.2 3.1 0 4.7-2.8 5.7-5.5 6 .4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .3Z" />
                      </svg>
                    )}
                    {l.kind === 'gitee' && <span class="font-mono text-[13px] font-bold">G</span>}
                    {l.kind === 'email' && (
                      <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="2" y="4" width="20" height="16" rx="2" />
                        <path d="m22 7-10 6L2 7" />
                      </svg>
                    )}
                  </span>
                  <span class="min-w-0 flex-1">
                    <span class="block text-[11px] text-fog-300">{l.label}</span>
                    <span class="ds-contact-value mono block truncate text-[13px]">
                      {l.value}
                    </span>
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div
      class="mt-14 flex flex-col gap-2 border-t border-ink-800 pt-6 text-xs text-fog-500 sm:flex-row sm:items-center sm:justify-between"
    >
      <p>© {year} {profile.name}</p>
      <p class="mono">
        {profile.education.school} · {profile.education.major} · {profile.education.degree} · {profile.education.range}
      </p>
    </div>
  </div>
</footer>

<!--
  ══════════════════════════════════════════════════════════════
  联系板块的文字可读性覆盖

  为什么需要这一块：
    联系板块的背景是全站唯一"完全透明"的位置 —— 3D 星野与原初深空
    直接透过来，而且它还落在页面最底部（画面最暗的区域）。
    实测该板块的文字渲染亮度确实低于其他板块，观感发闷。

  硬性约束（严格遵守）：
    · 只改文字颜色 / 字重 / 文字投影 / 卡片底色透明度这四个维度
    · 绝不动布局，绝不动其他板块，绝不提亮 3D 背景
    · 全部选择器都以 .ds-contact 作用域或专用的 .ds-contact-* 类名开头，
      不会影响到 Nav、Hero 等其他地方的 .btn / .card

  为什么用 !important：
    .card 与 .btn-ghost 定义在 global.css，且 .btn-primary 的背景是品牌青
    （#14b8a6），白色文字在它上面几乎没有对比度，必须把两种按钮分开处理。
    这里用 !important 保证覆盖顺序不受构建影响，行为可预测。
-->
<style>
  /* ── 1. 主标题：纯白 + 加粗一级 + 文字投影 ──────────────────
     原来是 font-bold(700) / color #f1f5fb。
     字重提到 800，颜色提到纯白，并加 1px 1px 2px 的暗色投影 ——
     投影的作用是"托住"文字，无论 3D 背景里的太阳或行星怎么移动，
     笔画边缘都不会和背景融在一起。 */
  .ds-contact h2 {
    color: #ffffff !important;
    font-weight: 800 !important;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.8);
  }

  /* 标题里的强调色（欢迎直接联系。）保持品牌青，但同样加投影 */
  .ds-contact h2 .text-accent-300 {
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.8);
  }

  /* ── 2. 副标题说明文字：中亮灰 + 不透明 + 投影 ────────────────
     原来是 text-fog-400 (#8b9ab1)，在深色星空下"若隐若现"。 */
  .ds-contact h2 + p {
    color: #b8c0cc !important;
    opacity: 1 !important;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.8);
  }

  /* ── 3. 右侧联系方式卡片 ────────────────────────────────────
     卡片底色原来是 ink-900 的 80%，这里加深到 94%，
     强化卡片与星空背景的边界感（只改不透明度，不改色相）。 */
  .ds-contact-card {
    background-color: color-mix(in srgb, var(--color-ink-900) 94%, transparent) !important;
  }

  /* 卡片内的文字与图标全部提到纯白 */
  .ds-contact-card .ds-contact-value {
    color: #ffffff !important;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.8);
  }
  .ds-contact-icon {
    color: #ffffff !important;
  }
  /* 悬停时仍然给品牌青，保留交互反馈 */
  .ds-contact-card:hover .ds-contact-value,
  .ds-contact-card:hover .ds-contact-icon {
    color: var(--color-accent-300) !important;
  }

  /* ── 4. 底部按钮 ────────────────────────────────────────────
     两种按钮分开处理，原因是对比度：

     · btn-ghost：底色是深色 ink-850，白字对比度最高 → 用纯白
     · btn-primary：底色是品牌青 accent-500 (#14b8a6)，属于中亮度背景。
       白字在它上面的对比度只有约 2.2:1（不合格），
       而原本的深色字是约 8:1（WCAG AAA 级）。
       所以这个按钮【保持深色字】—— 强行改白反而更难读。
       它本来就是所有按钮里最醒目的（实心青色），不需要再提亮。 */
  .ds-contact .btn-ghost {
    color: #ffffff !important;
    border-color: var(--color-ink-600) !important;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.8);
  }
  .ds-contact .btn-ghost:hover {
    color: var(--color-accent-300) !important;
  }

  /* 主按钮：只加投影提升边缘清晰度，字色保持高对比的深色 */
  .ds-contact .btn-primary {
    color: var(--color-ink-950) !important;
    font-weight: 700 !important;
    text-shadow: none;
  }
</style>
