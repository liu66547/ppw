---
/**
 * 项目板块 —— 从 src/content/projects/ 自动读取
 *
 * 设计决策：
 * - 两个项目格式统一（同样的信息结构：时间段 / 状态 / 标题 / 摘要 / 技术栈 / 关键数据 / 链接），
 *   但通过「栅格跨度 + 缩略图尺寸 + 字号 + 内边距」拉开主次（接口 7 : UI 5）。
 *   结构一致才叫格式一致；靠布局结构区分主次会破坏一致性。
 * - 接口自动化项目的实测数据（21 接口 / 35 用例 / 100% / 0 残留）内嵌在它自己的卡片里，
 *   不再单独占一个板块 —— 数据属于项目。
 */
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects'))
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order);

// 第一个项目是重点（占更大面积），其余走紧凑版
const [primary, ...rest] = projects;

// 主次比例：主项目 7 份，其余项目均分 5 份
const gridClass = (isPrimary: boolean) =>
  isPrimary
    ? 'lg:col-span-7'
    : rest.length > 1
      ? 'lg:col-span-5'
      : 'lg:col-span-5';
---

<section id="projects" class="section tilt-in border-t border-ink-800">
  <div class="wrap">
    <div class="max-w-2xl">
      <p class="eyebrow reveal">Projects</p>
      <h2 class="h-section reveal mt-3">项目经历</h2>
      <p class="reveal mt-4 text-sm leading-relaxed text-fog-400">
        两个项目都是独立完成的：架构设计、编码、用例执行、缺陷定位与文档全流程。
        点进详情页可以看到完整的架构说明、覆盖矩阵和缺陷证据链。
      </p>
    </div>

    <div class="mt-10 grid gap-5 lg:grid-cols-12">
      {
        [primary, ...rest].filter(Boolean).map((project, idx) => {
          const d = project!.data;
          const href = `/projects/${project!.id}/`;
          const isPrimary = idx === 0;
          const isWip = d.status === 'in-progress';
          const hasShots = d.screenshots.length > 0;

          return (
            <article
              class:list={[
                'card card-hoverable reveal flex flex-col overflow-hidden',
                gridClass(isPrimary),
              ]}
            >
              {/* 缩略图：两个项目格式一致 —— 都占位、等高。
                  有截图就显示截图，没有截图则显示一个中性的品牌头部，
                  避免"一个有图一个没图"造成卡片结构不一致。 */}
              <a
                href={href}
                class="group/thumb block overflow-hidden border-b border-ink-700 bg-ink-850"
                aria-label={`查看 ${d.title}`}
              >
                {hasShots ? (
                  <img
                    src={d.screenshots[0]!.src}
                    alt={d.screenshots[0]!.alt}
                    loading="lazy"
                    decoding="async"
                    class:list={[
                      'w-full object-cover object-top transition-transform duration-500 group-hover/thumb:scale-[1.015]',
                      isPrimary ? 'aspect-[16/7]' : 'aspect-[16/9]',
                    ]}
                  />
                ) : (
                  <div
                    class:list={[
                      'relative flex w-full items-end bg-dots-sm p-5',
                      isPrimary ? 'aspect-[16/7]' : 'aspect-[16/9]',
                    ]}
                  >
                    <div
                      class="pointer-events-none absolute inset-0 bg-gradient-to-t from-ink-850 via-ink-850/60 to-transparent"
                      aria-hidden="true"
                    >
                    </div>
                    <div class="relative">
                      <p class="mono text-[11px] uppercase tracking-widest text-accent-400">
                        {isWip ? 'Work in progress' : 'Project'}
                      </p>
                      <p class="mt-1 text-sm text-fog-400">
                        {isWip ? '截图待补充 —— 项目优化中' : '截图待补充'}
                      </p>
                    </div>
                  </div>
                )}
              </a>

              <div class:list={['flex flex-1 flex-col', isPrimary ? 'p-6 md:p-7' : 'p-5']}>
                <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
                  <span class="mono text-xs text-fog-500">{d.period}</span>
                  {isWip ? (
                    <span class="rounded border border-warn/40 bg-warn/10 px-1.5 py-0.5 text-[11px] font-medium text-warn">
                      进行中
                    </span>
                  ) : (
                    <span class="rounded border border-pass/35 bg-pass/10 px-1.5 py-0.5 text-[11px] font-medium text-pass">
                      已完成
                    </span>
                  )}
                  <span class="text-[11px] text-fog-500">{d.role}</span>
                </div>

                <h3
                  class:list={[
                    'mt-3 font-semibold tracking-tight text-fog-50',
                    isPrimary ? 'text-xl md:text-2xl' : 'text-lg',
                  ]}
                >
                  <a href={href} class="transition-colors hover:text-accent-300">
                    {d.title}
                  </a>
                </h3>

                <p
                  class:list={[
                    'mt-3 leading-relaxed text-fog-200',
                    isPrimary ? 'text-sm' : 'text-[13px]',
                  ]}
                >
                  {d.summary}
                </p>

                {d.statusNote && (
                  <p class="mt-2.5 text-xs leading-relaxed text-fog-500">{d.statusNote}</p>
                )}

                {/* 关键数据：内嵌在本项目卡片里 */}
                {d.highlights.length > 0 && (
                  <dl
                    class:list={[
                      'mt-5 grid gap-x-4 gap-y-4 border-t border-ink-700 pt-5',
                      isPrimary ? 'grid-cols-2 sm:grid-cols-4' : 'grid-cols-3',
                    ]}
                  >
                    {d.highlights.map((h) => (
                      <div>
                        <dt
                          class:list={[
                            'mono font-bold text-accent-300',
                            isPrimary ? 'text-xl md:text-2xl' : 'text-base',
                          ]}
                        >
                          {h.value}
                        </dt>
                        <dd class="mt-0.5 text-[11px] leading-snug text-fog-400">{h.label}</dd>
                      </div>
                    ))}
                  </dl>
                )}

                <ul class="mt-5 flex flex-wrap gap-1.5">
                  {d.tech.map((t) => (
                    <li class="chip">{t}</li>
                  ))}
                </ul>

                <div class="mt-6 flex flex-1 flex-wrap items-end gap-2.5">
                  <a href={href} class="btn btn-ghost !px-3.5 !py-2 !text-[13px]">
                    查看项目详情
                    <svg
                      class="size-3.5"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <line x1="5" y1="12" x2="19" y2="12" />
                      <polyline points="12 5 19 12 12 19" />
                    </svg>
                  </a>

                  {d.links.map((l) => (
                    <a
                      href={l.href}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="btn btn-ghost !px-3.5 !py-2 !text-[13px]"
                    >
                      {l.icon === 'github' ? (
                        <svg class="size-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                          <path d="M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 0-.8.4-1.3.7-1.6-2.7-.3-5.5-1.3-5.5-6 0-1.2.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0c2.3-1.5 3.3-1.2 3.3-1.2.6 1.7.2 2.9.1 3.2.8.8 1.2 1.9 1.2 3.1 0 4.7-2.8 5.7-5.5 6 .4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .3Z" />
                        </svg>
                      ) : (
                        <svg
                          class="size-3.5"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          aria-hidden="true"
                        >
                          <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
                          <polyline points="15 3 21 3 21 9" />
                          <line x1="10" y1="14" x2="21" y2="3" />
                        </svg>
                      )}
                      {l.label}
                    </a>
                  ))}
                </div>
              </div>
            </article>
          );
        })
      }
    </div>
  </div>
</section>
