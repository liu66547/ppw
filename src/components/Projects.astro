---
/**
 * 项目板块 —— 从 src/content/projects/ 自动读取
 * 加一个 .md 文件，这里就自动多一张卡片，不用改代码。
 *
 * 项目的实测数据（21 接口 / 35 用例 / 100% / 0 残留）作为本板块的抬头展示，
 * 而不是放在首屏 —— 数据属于项目，不该抢首屏的位置。
 */
import { getCollection } from 'astro:content';
import StatsBar from './StatsBar.astro';
import { profile } from '../data/profile';

const projects = (await getCollection('projects'))
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order);

// 数据条展示的是接口自动化项目的成果
const apiProject = projects.find((p) => p.id === 'xzs-api-test');
---

<section id="projects" class="section border-t border-ink-800">
  <div class="wrap">
    <div class="max-w-2xl">
      <p class="eyebrow reveal">Projects</p>
      <h2 class="h-section reveal mt-3">项目经历</h2>
      <p class="reveal mt-4 text-sm leading-relaxed text-fog-400">
        两个项目都是独立完成的：架构设计、编码、用例执行、缺陷定位与文档全流程。
        点进详情页可以看到完整的架构说明、覆盖矩阵和缺陷证据链。
      </p>
    </div>

    <!-- 实测数据：作为项目板块的抬头，明确归属 -->
    {
      apiProject && (
        <div class="mt-9">
          <StatsBar
            stats={profile.stats}
            scope={apiProject.data.title}
            href={`/projects/${apiProject.id}/`}
          />
        </div>
      )
    }

    <div class="mt-6 space-y-6">
      {
        projects.map((project) => {
          const d = project.data;
          const href = `/projects/${project.id}/`;
          const isWip = d.status === 'in-progress';

          return (
            <article class="card card-hoverable reveal overflow-hidden">
              <div class="grid gap-0 lg:grid-cols-[1.55fr_1fr]">
                {/* 左：主要信息 */}
                <div class="p-6 md:p-8">
                  <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
                    <span class="mono text-xs text-fog-500">{d.period}</span>
                    {isWip ? (
                      <span class="rounded border border-warn/40 bg-warn/10 px-1.5 py-0.5 text-[11px] font-medium text-warn">
                        进行中
                      </span>
                    ) : (
                      <span class="rounded border border-pass/35 bg-pass/10 px-1.5 py-0.5 text-[11px] font-medium text-pass">
                        已完成
                      </span>
                    )}
                    <span class="text-[11px] text-fog-500">{d.role}</span>
                  </div>

                  <h3 class="mt-3 text-xl font-semibold tracking-tight text-fog-50 md:text-2xl">
                    <a href={href} class="transition-colors hover:text-accent-300">
                      {d.title}
                    </a>
                  </h3>

                  <p class="mt-3 text-sm leading-relaxed text-fog-200">{d.summary}</p>

                  {d.statusNote && (
                    <p class="mt-2.5 text-xs leading-relaxed text-fog-500">{d.statusNote}</p>
                  )}

                  {/* 技术栈标签 */}
                  <ul class="mt-5 flex flex-wrap gap-1.5">
                    {d.tech.map((t) => (
                      <li class="chip">{t}</li>
                    ))}
                  </ul>

                  {/* 链接 */}
                  <div class="mt-6 flex flex-wrap items-center gap-2.5">
                    <a href={href} class="btn btn-ghost !px-3.5 !py-2 !text-[13px]">
                      查看项目详情
                      <svg
                        class="size-3.5"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                      >
                        <line x1="5" y1="12" x2="19" y2="12" />
                        <polyline points="12 5 19 12 12 19" />
                      </svg>
                    </a>

                    {d.links.map((l) => (
                      <a
                        href={l.href}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="btn btn-ghost !px-3.5 !py-2 !text-[13px]"
                      >
                        {l.icon === 'github' ? (
                          <svg class="size-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                            <path d="M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 0-.8.4-1.3.7-1.6-2.7-.3-5.5-1.3-5.5-6 0-1.2.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0c2.3-1.5 3.3-1.2 3.3-1.2.6 1.7.2 2.9.1 3.2.8.8 1.2 1.9 1.2 3.1 0 4.7-2.8 5.7-5.5 6 .4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .3Z" />
                          </svg>
                        ) : (
                          <svg
                            class="size-3.5"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            aria-hidden="true"
                          >
                            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
                            <polyline points="15 3 21 3 21 9" />
                            <line x1="10" y1="14" x2="21" y2="3" />
                          </svg>
                        )}
                        {l.label}
                      </a>
                    ))}
                  </div>
                </div>

                {/* 右：关键结果 */}
                <div class="border-t border-ink-700 bg-ink-850/50 p-6 md:p-8 lg:border-l lg:border-t-0">
                  <p class="mono text-[11px] uppercase tracking-widest text-fog-500">关键结果</p>
                  <dl class="mt-4 grid grid-cols-2 gap-x-4 gap-y-5 lg:grid-cols-1">
                    {d.highlights.map((h) => (
                      <div>
                        <dt class="mono text-xl font-bold text-accent-300 lg:text-2xl">{h.value}</dt>
                        <dd class="mt-0.5 text-xs text-fog-400">{h.label}</dd>
                      </div>
                    ))}
                  </dl>
                </div>
              </div>
            </article>
          );
        })
      }
    </div>
  </div>
</section>
