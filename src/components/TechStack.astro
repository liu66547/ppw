---
/**
 * 技术栈标签墙 —— 首屏下方
 * 按类别横向排开，让面试官快速扫一眼"这个人的工具面有多宽"
 */
import { techStack } from '../data/profile';
---

<section id="stack" class="tilt-in border-y border-ink-800 bg-ink-900/50">
  <div class="wrap py-10 md:py-12">
    <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-2">
      <p class="eyebrow reveal">Tech Stack</p>
      <p class="reveal mono text-xs text-fog-500">按类别排布，均来自实际项目</p>
    </div>

    <dl class="mt-7 space-y-4">
      {
        techStack.groups.map((g) => (
          <div class="reveal flex flex-col gap-2 sm:flex-row sm:items-baseline sm:gap-5">
            <dt class="mono w-20 shrink-0 text-xs uppercase tracking-wider text-fog-500">
              {g.label}
            </dt>
            <dd class="flex flex-wrap gap-1.5">
              {g.items.map((item) => (
                <span class="chip">{item}</span>
              ))}
            </dd>
          </div>
        ))
      }
    </dl>

    <p class="reveal mt-6 flex flex-wrap items-baseline gap-2 text-xs text-fog-500">
      <span class="mono uppercase tracking-wider">另有了解</span>
      {
        techStack.also.map((item) => (
          <span class="text-fog-400">{item}</span>
        ))
      }
    </p>
  </div>
</section>
