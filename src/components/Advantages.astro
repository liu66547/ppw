---
/**
 * 个人优势 —— 四个维度，每块带 2-3 条证据
 *
 * 组织逻辑：前三块是「现在能交付什么」，第四块是「以后能走多远」。
 * 每条都必须指向具体证据，不写"学习能力强"这类谁都能写的话。
 */
import { advantages } from '../data/profile';

// 每块一个图标，让四块在视觉上可区分
const icons: Record<string, string> = {
  // 测试思维：对勾 + 放大镜（验证与审视）
  mindset:
    'M11 3a8 8 0 1 0 5.3 14l4.35 4.35a1 1 0 0 0 1.4-1.4L17.7 15.6A8 8 0 0 0 11 3Zm0 2a6 6 0 1 1 0 12 6 6 0 0 1 0-12Z',
  // 框架设计：分层方块
  framework:
    'M12 2 2 7l10 5 10-5-10-5Zm0 2.3 5.9 2.95L12 10.2 6.1 7.25 12 4.3ZM2 12l10 5 10-5-1.8-.9L12 15.1 3.8 11.1 2 12Zm0 5 10 5 10-5-1.8-.9L12 20.1 3.8 16.1 2 17Z',
  // 工程化：齿轮
  engineering:
    'M12 8a4 4 0 1 0 0 8 4 4 0 0 0 0-8Zm0 2a2 2 0 1 1 0 4 2 2 0 0 1 0-4Zm-1.2-8h2.4l.4 2.4 1.6.66 2-1.4 1.7 1.7-1.4 2 .66 1.6L21 9.2v2.4l-2.4.4-.66 1.6 1.4 2-1.7 1.7-2-1.4-1.6.66L13.2 21h-2.4l-.4-2.4-1.6-.66-2 1.4-1.7-1.7 1.4-2-.66-1.6L3 13.2v-2.4l2.4-.4.66-1.6-1.4-2 1.7-1.7 2 1.4 1.6-.66L10.8 2Z',
  // 成长：向上箭头 + 趋势
  growth: 'M3 17.5 9.5 11l4 4L21 7.5 19.6 6.1l-6.1 6.1-4-4L3 15.5v2Z',
};
---

<section id="advantages" class="section tilt-in">
  <div class="wrap">
    <div class="max-w-2xl">
      <p class="eyebrow reveal">Strengths</p>
      <h2 class="h-section reveal mt-3">个人优势</h2>
      <p class="reveal mt-4 text-sm leading-relaxed text-fog-400">
        四个维度：前三块是现在能交付什么，第四块是以后能走多远。
        每一条都能用项目里的代码、数字和证据核对，不是自我评价。
      </p>
    </div>

    <div class="mt-10 grid gap-5 lg:grid-cols-2">
      {
        advantages.map((a, i) => (
          <article class="card reveal flex flex-col p-6 md:p-7">
            <div class="flex items-start gap-4">
              <span
                class="grid size-10 shrink-0 place-items-center rounded-lg border border-accent-500/30 bg-accent-500/10"
                aria-hidden="true"
              >
                <svg class="size-5 text-accent-300" viewBox="0 0 24 24" fill="currentColor">
                  <path d={icons[a.id]} />
                </svg>
              </span>

              <div class="min-w-0 flex-1">
                <p class="mono text-[11px] uppercase tracking-widest text-accent-400">
                  {String(i + 1).padStart(2, '0')} · {a.group}
                </p>
                <h3 class="mt-1.5 text-base font-semibold leading-snug text-fog-50">
                  {a.title}
                </h3>
              </div>
            </div>

            <p class="mt-4 text-[13px] font-medium text-accent-300">{a.summary}</p>

            <ul class="mt-4 flex flex-1 flex-col justify-between gap-2.5">
              {a.points.map((pt) => (
                <li class="flex gap-2.5 text-[13px] leading-relaxed text-fog-400">
                  <span class="mt-2 size-1 shrink-0 rounded-full bg-ink-600" aria-hidden="true" />
                  <span>{pt}</span>
                </li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </div>
</section>
