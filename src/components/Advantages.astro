---
/**
 * 个人优势 —— 「我为什么值得看」的四个理由
 *
 * 每一条都指向具体证据，不写"学习能力强""抗压能力好"这类谁都能写的话。
 */
import { advantages } from '../data/profile';
---

<section id="advantages" class="section">
  <div class="wrap">
    <div class="max-w-2xl">
      <p class="eyebrow reveal">Strengths</p>
      <h2 class="h-section reveal mt-3">个人优势</h2>
      <p class="reveal mt-4 text-sm leading-relaxed text-fog-400">
        下面四条不是自我评价，是可以用项目里的代码、数字和证据核对的能力。
      </p>
    </div>

    <!-- 用 flex 撑开内容，让同行两张卡片底边齐平 -->
    <div class="mt-10 grid gap-5 md:grid-cols-2">
      {
        advantages.map((a, i) => (
          <article class="card reveal flex flex-col p-6">
            <div class="flex items-start justify-between gap-4">
              <h3 class="text-base font-semibold leading-snug text-fog-50">{a.title}</h3>
              <span class="mono shrink-0 text-xs text-ink-600">
                {String(i + 1).padStart(2, '0')}
              </span>
            </div>

            <p class="mt-2.5 text-[13px] font-medium text-accent-300">{a.summary}</p>

            <p class="mt-3 flex-1 text-[13px] leading-relaxed text-fog-400">{a.detail}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
