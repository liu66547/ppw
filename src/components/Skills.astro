---
/**
 * 技能板块 —— 按熟练度分档，每项带"证据"说明在哪用过
 * 只列"我会什么"而说不出"在哪用过"的技能，面试一追问就露馅，所以每项都写了 evidence。
 */
import { skillGroups, levelLabel } from '../data/skills';

// 核心技能（主打能力）排前面，且用更醒目的样式
const core = skillGroups.filter((g) => g.core);
const rest = skillGroups.filter((g) => !g.core);

const levelClass: Record<string, string> = {
  skill: 'border-accent-500/45 bg-accent-500/12 text-accent-300',
  familiar: 'border-azure-500/40 bg-azure-500/10 text-azure-300',
  know: 'border-ink-600 bg-ink-800 text-fog-400',
};
---

<section id="skills" class="section">
  <div class="wrap">
    <div class="max-w-2xl">
      <p class="eyebrow reveal">Skills</p>
      <h2 class="h-section reveal mt-3">专业技能</h2>
      <p class="reveal mt-4 text-sm leading-relaxed text-fog-400">
        每项技能都标注了我用它在哪个项目里做过什么 —— 这比列一串关键词有用。
        熟练度分三档：<span class="text-accent-300">熟练</span> ·
        <span class="text-azure-300">熟悉</span> ·
        <span class="text-fog-400">了解</span>，口径与简历一致，不夸大。
      </p>
    </div>

    <!-- 核心能力：两列大卡片 -->
    <div class="mt-10 grid gap-5 lg:grid-cols-2">
      {
        core.map((group) => (
          <div class="card reveal p-6">
            <div class="flex items-center gap-2.5">
              <span class="size-1.5 rounded-full bg-accent-400" aria-hidden="true" />
              <h3 class="text-base font-semibold text-fog-50">{group.name}</h3>
            </div>

            <ul class="mt-5 space-y-5">
              {group.items.map((item) => (
                <li>
                  <div class="flex flex-wrap items-center gap-x-2.5 gap-y-1.5">
                    <span class="text-sm font-medium text-fog-50">{item.name}</span>
                    <span
                      class:list={[
                        'rounded border px-1.5 py-0.5 text-[11px] font-medium',
                        levelClass[item.level],
                      ]}
                    >
                      {levelLabel[item.level]}
                    </span>
                  </div>
                  <p class="mt-1.5 text-[13px] leading-relaxed text-fog-500">
                    {item.evidence}
                  </p>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <!-- 其他技能：三列紧凑卡片 -->
    <div class="mt-5 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        rest.map((group) => (
          <div class="card reveal p-5">
            <h3 class="text-sm font-semibold text-fog-50">{group.name}</h3>
            <ul class="mt-4 space-y-3.5">
              {group.items.map((item) => (
                <li>
                  <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
                    <span class="text-[13px] text-fog-200">{item.name}</span>
                    <span
                      class:list={[
                        'rounded border px-1.5 py-px text-[10px]',
                        levelClass[item.level],
                      ]}
                    >
                      {levelLabel[item.level]}
                    </span>
                  </div>
                  <p class="mt-1 text-xs leading-relaxed text-fog-500">{item.evidence}</p>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>
