---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import TechStack from '../components/TechStack.astro';
import Skills from '../components/Skills.astro';
import Advantages from '../components/Advantages.astro';
import Projects from '../components/Projects.astro';
import { profile } from '../data/profile';

/**
 * 首页板块顺序（保持既定结构，不随意增减板块）：
 *   1. Hero        —— 我是谁、怎么联系我
 *   2. TechStack   —— 我的工具面有多宽（一眼扫完）
 *   3. Skills      —— 我的专业能力，每项都带"在哪用过"
 *   4. Advantages  —— 四个维度的优势，每条都有证据
 *   5. Projects    —— 项目经历（实测数据内嵌在各项目卡片里）
 *
 * 所在地（深圳南山）按要求放在页面最下方的页脚，不占首屏。
 */

// 结构化数据：帮助搜索引擎正确理解这是"一个人"，而不是一个公司网站
const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  alternateName: profile.nameEn,
  jobTitle: profile.title,
  email: `mailto:${profile.contact.email}`,
  url: Astro.site?.href,
  sameAs: [profile.contact.github, profile.contact.gitee],
  address: {
    '@type': 'PostalAddress',
    addressLocality: profile.location.city,
    addressRegion: profile.location.district,
    addressCountry: 'CN',
  },  alumniOf: {
    '@type': 'CollegeOrUniversity',
    name: profile.education.school,
  },
  knowsAbout: [
    '接口自动化测试',
    'UI 自动化测试',
    'Selenium WebDriver',
    'RestAssured',
    'TestNG',
    'Jenkins',
    'Allure',
  ],
};
---

<BaseLayout>
  <script type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />

  <Hero />
  <TechStack />
  <Skills />
  <Advantages />
  <Projects />
</BaseLayout>
