---
/**
 * 项目详情页
 * 路由由文件名决定：src/content/projects/xzs-api-test.md → /projects/xzs-api-test
 */
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ScreenshotGallery from '../../components/ScreenshotGallery.astro';
import VerdictCard from '../../components/VerdictCard.astro';
import { profile } from '../../data/profile';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const d = project.data;
const { Content, headings } = await render(project);

// 从正文标题生成右侧目录（只取 h2 / h3）
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);

const isWip = d.status === 'in-progress';
const others = (await getCollection('projects'))
  .filter((p) => p.id !== project.id && p.data.featured)
  .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title={d.title} description={d.description}>
  <!-- 返回 -->
  <div class="border-b border-ink-800 bg-ink-900/30">
    <div class="wrap py-4">
      <a
        href="/#projects"
        class="inline-flex items-center gap-1.5 text-sm text-fog-400 transition-colors hover:text-accent-300"
      >
        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="19" y1="12" x2="5" y2="12" />
          <polyline points="12 19 5 12 12 5" />
        </svg>
        返回项目列表
      </a>
    </div>
  </div>

  <!-- 项目头部 -->
  <header class="relative overflow-hidden border-b border-ink-800">
    <div class="pointer-events-none absolute inset-0 bg-dots mask-fade" aria-hidden="true"></div>

    <div class="wrap relative py-12 md:py-16">
      <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
        <span class="mono text-xs text-fog-500">{d.period}</span>
        {
          isWip ? (
            <span class="rounded border border-warn/40 bg-warn/10 px-1.5 py-0.5 text-[11px] font-medium text-warn">
              进行中
            </span>
          ) : (
            <span class="rounded border border-pass/35 bg-pass/10 px-1.5 py-0.5 text-[11px] font-medium text-pass">
              已完成
            </span>
          )
        }
        <span class="text-[11px] text-fog-500">{d.role}</span>
      </div>

      <h1 class="mt-4 max-w-3xl text-3xl font-bold leading-tight tracking-tight text-fog-50 md:text-4xl">
        {d.title}
      </h1>

      <p class="mt-4 max-w-3xl text-sm leading-relaxed text-fog-200 md:text-base">
        {d.description}
      </p>

      {d.statusNote && <p class="mt-3 text-xs text-warn/90">{d.statusNote}</p>}

      <!-- 技术栈 -->
      <ul class="mt-6 flex flex-wrap gap-1.5">
        {d.tech.map((t) => <li class="chip">{t}</li>)}
      </ul>

      <!-- 关键数据 -->
      {
        d.highlights.length > 0 && (
          <dl class="mt-8 grid grid-cols-2 gap-x-6 gap-y-5 border-t border-ink-700 pt-6 sm:grid-cols-4">
            {d.highlights.map((h) => (
              <div>
                <dt class="mono text-xl font-bold text-accent-300 md:text-2xl">{h.value}</dt>
                <dd class="mt-0.5 text-xs text-fog-400">{h.label}</dd>
              </div>
            ))}
          </dl>
        )
      }

      <!-- 仓库链接 -->
      {
        d.links.length > 0 && (
          <div class="mt-7 flex flex-wrap gap-2.5">
            {d.links.map((l) => (
              <a
                href={l.href}
                target="_blank"
                rel="noopener noreferrer"
                class="btn btn-ghost !px-3.5 !py-2 !text-[13px]"
              >
                {l.icon === 'github' ? (
                  <svg class="size-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 0-.8.4-1.3.7-1.6-2.7-.3-5.5-1.3-5.5-6 0-1.2.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0c2.3-1.5 3.3-1.2 3.3-1.2.6 1.7.2 2.9.1 3.2.8.8 1.2 1.9 1.2 3.1 0 4.7-2.8 5.7-5.5 6 .4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .3Z" />
                  </svg>
                ) : (
                  <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
                    <polyline points="15 3 21 3 21 9" />
                    <line x1="10" y1="14" x2="21" y2="3" />
                  </svg>
                )}
                {l.label}
              </a>
            ))}
          </div>
        )
      }
    </div>
  </header>

  <!-- 30 秒看懂：一句话结论 + 要点 + 证据索引 -->
  {
    d.verdict && (
      <VerdictCard
        headline={d.verdict.headline}
        points={d.verdict.points}
        evidence={d.evidence}
      />
    )
  }

  <!-- 正文 + 侧边目录 -->
  <div class="wrap py-12 md:py-16">
    <div class="grid gap-12 lg:grid-cols-[minmax(0,1fr)_15rem]">
      <article class="prose-tech min-w-0">
        <Content />

        <ScreenshotGallery screenshots={d.screenshots} />
      </article>

      <aside class="hidden lg:block">
        <div class="sticky top-24">
          <p class="mono text-[11px] uppercase tracking-widest text-fog-500">本页目录</p>
          <nav class="mt-3 border-l border-ink-700" aria-label="页内目录">
            <ul class="space-y-1.5">
              {
                toc.map((h) => (
                  <li>
                    <a
                      href={`#${h.slug}`}
                      class:list={[
                        'block border-l-2 border-transparent py-0.5 text-[13px] leading-snug text-fog-500 transition-colors hover:border-accent-500 hover:text-accent-300',
                        h.depth === 2 ? '-ml-px pl-3' : '-ml-px pl-6 text-xs',
                      ]}
                    >
                      {h.text}
                    </a>
                  </li>
                ))
              }
              {
                d.screenshots.length > 0 && (
                  <li>
                    <a
                      href="#screenshots"
                      class="-ml-px block border-l-2 border-transparent py-0.5 pl-3 text-[13px] leading-snug text-fog-500 transition-colors hover:border-accent-500 hover:text-accent-300"
                    >
                      项目截图
                    </a>
                  </li>
                )
              }
            </ul>
          </nav>

          <a
            href={profile.contact.resumeFile}
            download
            class="btn btn-ghost mt-8 w-full !text-[13px]"
          >
            下载简历 PDF
          </a>
        </div>
      </aside>
    </div>
  </div>

  <!-- 其他项目 -->
  {
    others.length > 0 && (
      <section class="border-t border-ink-800 bg-ink-900/40">
        <div class="wrap py-12">
          <p class="mono text-[11px] uppercase tracking-widest text-fog-500">其他项目</p>
          <div class="mt-5 grid gap-4 sm:grid-cols-2">
            {others.map((o) => (
              <a
                href={`/projects/${o.id}`}
                class="card card-hoverable group block p-5"
              >
                <div class="flex items-center justify-between gap-3">
                  <h3 class="text-sm font-semibold text-fog-50 transition-colors group-hover:text-accent-300">
                    {o.data.title}
                  </h3>
                  <span class="mono shrink-0 text-[11px] text-fog-500">{o.data.period}</span>
                </div>
                <p class="mt-2 line-clamp-2 text-xs leading-relaxed text-fog-400">
                  {o.data.summary}
                </p>
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <script>
    /**
     * 折叠区块的产品逻辑：**不锁内容，只降低打扰**
     *
     * 折叠块默认收起是为了减少首屏的视觉负担，但内容必须随时可达 ——
     * 所以这里做一件事：当访问者通过目录锚点跳到某个折叠块，或直接访问
     * 带锚点的 URL 时，自动把目标块展开，不需要他再点一次。
     */
    const openTargetDetails = () => {
      const hash = window.location.hash;
      if (!hash) return;

      let el;
      try {
        el = document.querySelector(hash);
      } catch {
        return; // 非法选择器，忽略
      }
      if (!el) return;

      // 目标本身是 details，或者它在某个 details 内部
      const details = el.closest('details');
      if (details) {
        details.open = true;
        // 展开后内容位置会变，把目标重新对到视口
        window.requestAnimationFrame(() => el.scrollIntoView({ block: 'start' }));
      }
    };

    openTargetDetails();
    window.addEventListener('hashchange', openTargetDetails);
  </script>
</BaseLayout>
