---
/**
 * 全站基础布局：<head>、导航栏、页脚
 */
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import ResumePreview from '../components/ResumePreview.astro';
import DeepSpaceIntro from '../components/DeepSpaceIntro.astro';
import { site } from '../data/profile';

interface Props {
  title?: string;
  description?: string;
  /** 设置后该页不参与搜索引擎收录（用于 404 这类功能性页面） */
  noindex?: boolean;
}

const { title, description = site.description, noindex = false } = Astro.props;
// 首页用 homeTitle 原文，子页面用「页面名 · 站点后缀」
const pageTitle = title ? `${title} · ${site.titleSuffix}` : site.homeTitle;
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).href;

/**
 * 滚动吸附与 3D 斜向进入只对首页启用。
 * 项目详情页内容很长，加了吸附会让人读不下去。
 */
const isHome = Astro.url.pathname === '/';
---

<!doctype html>
<html lang="zh-CN" class:list={[isHome && 'snap-enabled']}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex, follow" /> : <link rel="canonical" href={canonical} />}

    <!-- 社交分享卡片 -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#05070d" />

    <!--
      兜底：入场动画的元素默认 opacity:0，靠 JS 加 .is-visible 才显示。
      万一浏览器禁用或加载不了 JS，这里强制全部可见 —— 内容永远不能被脚本"扣住"。
    -->
    <noscript>
      <style>
        .reveal {
          opacity: 1 !important;
          transform: none !important;
        }
      </style>
    </noscript>
  </head>

  <body class="min-h-screen antialiased">
    <!-- 全页共用的背景光晕（极慢漂移 + 呼吸），详细设计取舍见 global.css。
         注意：3D 背景启用时该光晕会被组件临时收掉，避免与星云重复叠加。 -->
    <div class="aurora" aria-hidden="true"></div>

    <!-- 全页太阳系流星 3D 背景：画布固定在最底层，滚动进度驱动三幕镜头 -->
    <DeepSpaceIntro />

    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-accent-500 focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-ink-950"
    >
      跳到主要内容
    </a>

    <Nav />

    <main id="main">
      <slot />
    </main>

    <Footer />

    <!-- 简历在线预览弹层：全局挂载一次，任何带 data-resume-preview 的按钮都能唤起 -->
    <ResumePreview />

    <script>
      // 滚动入场动画：元素进入视口时淡入
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const targets = document.querySelectorAll('.reveal');

      const showAll = () => targets.forEach((el) => el.classList.add('is-visible'));

      if (reduce || !('IntersectionObserver' in window)) {
        showAll();
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            });
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.05 }
        );
        targets.forEach((el) => io.observe(el));

        // 兜底：无论如何 2.5 秒后强制显示全部内容。
        // 入场动画是锦上添花，绝不能因为观察器出问题而让内容一直看不见。
        window.setTimeout(showAll, 2500);
      }
    </script>

    <script>
      /**
       * 滚动吸附：只给「放得下」的板块打吸附点。
       *
       * 为什么用脚本判断而不是纯 CSS：
       *   板块内容超过一屏时，强制吸附会把用户困在板块顶部、内容读不完。
       *   这里测量每个板块高度，只有 ≤ 视口高 92% 的才开启吸附，
       *   高内容板块自动豁免，可以自由滚动读完。
       */
      const snapEnabled = document.documentElement.classList.contains('snap-enabled');
      const allowMotion = window.matchMedia('(prefers-reduced-motion: no-preference)').matches;

      if (snapEnabled && allowMotion) {
        const markSnapPoints = () => {
          const limit = window.innerHeight * 0.92;
          document.querySelectorAll('main > section').forEach((el) => {
            const fits = el.getBoundingClientRect().height <= limit;
            el.classList.toggle('snap-point', fits);
          });
        };

        // 等字体与图片稳定后再测量，避免测到中间态
        if (document.readyState === 'complete') {
          markSnapPoints();
        } else {
          window.addEventListener('load', markSnapPoints, { once: true });
        }

        let resizeTimer: number | undefined;
        window.addEventListener('resize', () => {
          window.clearTimeout(resizeTimer);
          resizeTimer = window.setTimeout(markSnapPoints, 200);
        });
      } else if (snapEnabled) {
        // 用户偏好「减少动态效果」时直接关掉吸附
        document.documentElement.classList.remove('snap-enabled');
      }
    </script>
  </body>
</html>
