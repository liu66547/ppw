# build output
dist/
.output/

# generated types
.astro/

# dependencies
node_modules/
.npm-cache/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# environment variables
# 注意：本项目的 .env 只有 ASTRO_TELEMETRY_DISABLED=1，不含任何密钥，
# 所以下面用 !.env 把它纳入版本控制，保证任何人 clone 后构建行为一致。
.env
.env.production
!.env

# macOS / Windows
.DS_Store
Thumbs.db

# editors
.vscode/*
!.vscode/extensions.json
.idea/

# 开发辅助脚本目录：忽略里面的内容（含一个从简历 PDF 提取文字的私人脚本）
# 注意必须写成 _tools/* 而不是 _tools/ —— 目录整体被忽略时 Git 不会遍历进去，
# 后面的 ! 放行规则就不会生效。
# 放行验收脚本是因为 GitHub Actions 的 CI 需要它。
_tools/*
!_tools/acceptance_check.py

# 本地截图验证产物
_shots/

# Vercel
.vercel
